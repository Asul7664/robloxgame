			<Item class="ModuleScript" referent="RBXQC023WaterJump">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Local-character water leap. Space stays with Roblox's normal jump controller.
-- No fishing/reward remotes. The character's simulation owner applies one impulse.
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local WaterJump = {}
WaterJump.__index = WaterJump
local STATES = Enum.HumanoidStateType

function WaterJump:_restoreSwimming()
    if self.SuppressedHumanoid then
        local humanoid = self.SuppressedHumanoid
        if humanoid.Parent then humanoid:SetStateEnabled(STATES.Swimming, self.PreviousSwimming) end
        self.SuppressedHumanoid = nil
    end
    self.Pending = false
end

function WaterJump:_clear()
    self.Generation = self.Generation + 1
    self:_restoreSwimming()
    if self.StateConnection then self.StateConnection:Disconnect(); self.StateConnection = nil end
    self.Character, self.Humanoid, self.Root = nil, nil, nil
    self.LastWaterAt, self.LastJumpAt = -math.huge, -math.huge
end

function WaterJump:_bind(character)
    if self.Dead or character ~= self.Player.Character then return end
    self:_clear()
    local generation = self.Generation
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if self.Dead or generation ~= self.Generation or character ~= self.Player.Character
        or not humanoid or not root then return end
    self.Character, self.Humanoid, self.Root = character, humanoid, root
    if humanoid:GetState() == STATES.Swimming then self.LastWaterAt = os.clock() end
    self.StateConnection = humanoid.StateChanged:Connect(function(old, new)
        if self.SuppressedHumanoid then return end
        if old == STATES.Swimming or new == STATES.Swimming then
            self.LastWaterAt = os.clock()
        end
    end)
end

function WaterJump:_valid()
    return not self.Dead and self.Player.Character == self.Character
        and self.Humanoid and self.Humanoid.Parent and self.Humanoid.Health > 0
        and self.Root and self.Root.Parent and not self.Root.Anchored
end

function WaterJump:Request()
    if not self.Settings.Enabled or not self:_valid() or not self.CanJump()
        or UIS:GetFocusedTextBox() then return false end
    local humanoid, root = self.Humanoid, self.Root
    local now = os.clock()
    if self.SuppressedHumanoid or self.Pending or now - self.LastJumpAt < self.Settings.Cooldown then return false end
    if not humanoid:GetStateEnabled(STATES.Jumping) or not humanoid:GetStateEnabled(STATES.Swimming) then return false end
    if (humanoid.UseJumpPower and humanoid.JumpPower <= 0)
        or (not humanoid.UseJumpPower and humanoid.JumpHeight <= 0) then return false end
    local state = humanoid:GetState()
    local justLeftWater = (state == STATES.Jumping or state == STATES.Freefall)
        and now - self.LastWaterAt <= self.Settings.ExitGraceSeconds
    if state ~= STATES.Swimming and not justLeftWater then return false end
    local mass = root.AssemblyMass
    if mass <= 0 or mass == math.huge or mass ~= mass then return false end
    self.LastJumpAt, self.LastWaterAt = now, -math.huge
    self.SuppressedHumanoid = humanoid
    self.PreviousSwimming = humanoid:GetStateEnabled(STATES.Swimming)
    self.RestoreAt = now + self.Settings.SwimReleaseSeconds
    self.Pending = true
    humanoid:SetStateEnabled(STATES.Swimming, false)
    -- Queue the impulse for PreSimulation. It must not fight the stock swim force
    -- or the normal jump impulse applied by the default controls in this frame.
    return true
end

function WaterJump:_step()
    if not self:_valid() then self:_restoreSwimming(); return end
    local humanoid, root = self.Humanoid, self.Root
    local now = os.clock()
    if self.Pending then
        self.Pending = false
        if not self.CanJump() then self:_restoreSwimming(); return end
        local velocity = root.AssemblyLinearVelocity
        local mass = root.AssemblyMass
        if velocity.Y ~= velocity.Y or mass <= 0 or mass == math.huge or mass ~= mass then
            self:_restoreSwimming(); return
        end
        -- Freefall permits a ballistic upward leap without resetting Y velocity
        -- to Humanoid.JumpPower. X/Z velocity and normal air steering are retained.
        humanoid.Jump = false
        humanoid:ChangeState(STATES.Freefall)
        local dy = math.clamp(self.Settings.UpwardSpeed - velocity.Y, 0, self.Settings.UpwardSpeed * 2)
        root:ApplyImpulse(Vector3.new(0, dy * mass, 0))
    end
    if self.SuppressedHumanoid and now >= self.RestoreAt then self:_restoreSwimming() end
    if not self.SuppressedHumanoid and humanoid:GetState() == STATES.Swimming then
        self.LastWaterAt = now
    end
end

function WaterJump.new(player, settings, canJump)
    local self = setmetatable({Player = player, Settings = settings,
        CanJump = canJump or function() return true end,
        Connections = {}, Generation = 0, Dead = false, Pending = false,
        LastWaterAt = -math.huge, LastJumpAt = -math.huge}, WaterJump)
    table.insert(self.Connections, player.CharacterAdded:Connect(function(character)
        task.spawn(function() self:_bind(character) end)
    end))
    table.insert(self.Connections, player.CharacterRemoving:Connect(function(character)
        if character == self.Character then self:_clear() end
    end))
    table.insert(self.Connections, UIS.JumpRequest:Connect(function() self:Request() end))
    table.insert(self.Connections, RunService.PreSimulation:Connect(function() self:_step() end))
    if player.Character then task.spawn(function() self:_bind(player.Character) end) end
    return self
end

function WaterJump:Destroy()
    if self.Dead then return end
    self.Dead = true
    self:_clear()
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
    self.Connections = {}
end
return WaterJump
]]></ProtectedString>
					<string name="ScriptGuid">{F7035902-0B09-420D-9395-EF0BB6D67B63}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WaterJump</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc00000999</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC024CatchArtCatalog">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Presentation-only mapping; every key matches an existing server species ID.
local parent = script.Parent
local art = parent:WaitForChild("CatchArtData")
local Catalog = {}
local known = {capybara=true, skibidi=true, sigma=true, ballerina=true, tralalero=true,
    patapim=true, ambalabu=true, bombardiro=true, sahur=true, gigachad=true}
function Catalog.Has(species)
    local supplied=type(species)=="string" and art:FindFirstChild(species)
    return known[species]==true or (supplied and supplied:IsA("ModuleScript"))==true
end
function Catalog.Get(species)
    assert(Catalog.Has(species), "Unknown catch portrait: " .. tostring(species))
    if species == "sahur" then return require(parent:WaitForChild("SahurArtData")) end
    return require(art:WaitForChild(species))
end
return Catalog
]]></ProtectedString>
					<string name="ScriptGuid">{6757DB3F-C60C-4033-9DB7-B990D91F24EE}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CatchArtCatalog</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000099a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC024CatchSprite">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- One supplied portrait per mount. No reward remotes; no external asset IDs needed.
-- Native: EditableImage. Portable fallback: low-resolution UIGradient strips.
-- The owner limits the cache to two portraits, including their native images.
local AssetService = game:GetService("AssetService")
local Catalog = require(script.Parent:WaitForChild("CatchArtCatalog"))
local Sprite = {}
local function decodeBase64(encoded)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end
    local clean = string.gsub(encoded, "%s", "")
    local output = buffer.create(math.floor(#clean * 3 / 4))
    local accumulator, bits, count = 0, 0, 0
    for i = 1, #clean do
        local byte = string.byte(clean, i)
        local value = lookup[byte]
        if value ~= nil then
            accumulator = accumulator * 64 + value; bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local power = 2 ^ bits
                buffer.writeu8(output, count, math.floor(accumulator / power))
                count = count + 1; accumulator = accumulator % power
            end
        else
            assert(byte == 61, "Invalid embedded portrait base64")
        end
    end
    return output, count
end
function Sprite.Decode(data)
    assert(type(data) == "table" and data.Width > 0 and data.Height > 0, "Invalid portrait size")
    local runs, length = decodeBase64(data.Pixels)
    assert(length % 2 == 0, "Incomplete portrait run")
    local total, pixel = data.Width * data.Height, 0
    local pixels = buffer.create(total * 4)
    for offset = 0, length - 1, 2 do
        local count = buffer.readu8(runs, offset)
        local color = data.Palette[buffer.readu8(runs, offset + 1) + 1]
        assert(count > 0 and color ~= nil and pixel + count <= total, "Corrupt portrait color run")
        for _ = 1, count do buffer.writeu32(pixels, pixel * 4, color); pixel = pixel + 1 end
    end
    assert(pixel == total, "Incorrect portrait pixel count")
    if data.Alphas then
        local alphaRuns, alphaLength = decodeBase64(data.Alphas)
        assert(alphaLength % 2 == 0, "Incomplete portrait alpha run")
        pixel = 0
        for offset = 0, alphaLength - 1, 2 do
            local count = buffer.readu8(alphaRuns, offset)
            local alpha = buffer.readu8(alphaRuns, offset + 1)
            assert(count > 0 and pixel + count <= total, "Corrupt portrait alpha")
            for _ = 1, count do buffer.writeu8(pixels, pixel * 4 + 3, alpha); pixel = pixel + 1 end
        end
        assert(pixel == total, "Incorrect portrait alpha count")
    end
    return pixels
end
local function sample(data, pixels, x, y, resolution)
    local sx = math.min(data.Width - 1, math.floor((x + 0.5) * data.Width / resolution))
    local sy = math.min(data.Height - 1, math.floor((y + 0.5) * data.Height / resolution))
    local offset = (sy * data.Width + sx) * 4
    return Color3.fromRGB(buffer.readu8(pixels, offset), buffer.readu8(pixels, offset+1), buffer.readu8(pixels, offset+2)),
        1 - buffer.readu8(pixels, offset+3) / 255
end
local function makeFallback(root, data, pixels, alive, known)
    -- <=20 strictly ordered keypoints in every sequence; at most 1,024 strips.
    local resolution, stripHeight = 128, 18
    local result = Instance.new("Frame")
    result.Name = "PortablePicture"; result.Size = UDim2.fromScale(1,1)
    result.BackgroundTransparency = 1; result.Visible = false; result.ZIndex = 3; result.Parent = root
    local count = 0
    for x = 0, resolution - 1 do
        for y = 0, resolution - 1, stripHeight do
            if not alive() then result:Destroy(); return nil end
            local height = math.min(stripHeight, resolution - y)
            local colors, alphas, visible = {}, {}, false
            for row = 0, height - 1 do
                local color, transparency = sample(data, pixels, x, y+row, resolution)
                colors[row+1], alphas[row+1] = known==false and Color3.fromRGB(37,54,65) or color, transparency
                if transparency < 0.999 then visible = true end
            end
            if visible then
                local colorKeys = {ColorSequenceKeypoint.new(0, colors[1])}
                local alphaKeys = {NumberSequenceKeypoint.new(0, alphas[1])}
                for row = 1, height do
                    local t = (row - 0.5) / height
                    table.insert(colorKeys, ColorSequenceKeypoint.new(t, colors[row]))
                    table.insert(alphaKeys, NumberSequenceKeypoint.new(t, alphas[row]))
                end
                table.insert(colorKeys, ColorSequenceKeypoint.new(1, colors[height]))
                table.insert(alphaKeys, NumberSequenceKeypoint.new(1, alphas[height]))
                local strip = Instance.new("Frame")
                strip.Name = "Strip"; strip.BorderSizePixel = 0
                strip.BackgroundColor3 = Color3.new(1,1,1); strip.ZIndex = 3
                strip.Position = UDim2.fromScale(x / resolution, y / resolution)
                strip.Size = UDim2.fromScale(1 / resolution, height / resolution)
                local gradient = Instance.new("UIGradient")
                gradient.Rotation = 90; gradient.Color = ColorSequence.new(colorKeys)
                gradient.Transparency = NumberSequence.new(alphaKeys)
                gradient.Parent = strip; strip.Parent = result
                count = count + 1
                if count % 48 == 0 then task.wait() end
            end
        end
    end
    result:SetAttribute("StripCount", count); result.Visible = true
    return result
end
function Sprite.Has(species) return Catalog.Has(species) end
function Sprite.Mount(parent, species, forcePortable, known)
    local root = Instance.new("Frame")
    root.Name = "Portrait_" .. species; root.Size = UDim2.fromScale(1,1)
    root.BackgroundTransparency = 1; root.ZIndex = 3; root.Parent = parent
    local state = {Species=species, Root=root, Ready=false, Mode="loading", Dead=false, Image=nil}
    local function alive() return not state.Dead and root.Parent ~= nil end
    function state:SetVisible(value) if not self.Dead then self.Root.Visible = value end end
    function state:Destroy()
        if self.Dead then return end
        self.Dead = true
        if self.Image then self.Image:Destroy(); self.Image = nil end
        if self.Root then self.Root:Destroy() end
    end
    task.spawn(function()
        local ok, data = pcall(Catalog.Get, species)
        local pixels
        if ok then ok, pixels = pcall(Sprite.Decode, data) end
        if not ok then
            if alive() then
                state.Mode = "error"; state.Ready = true
                warn("[QuietCove] Portrait decode failed: " .. species .. ": " .. tostring(pixels or data))
            end
            return
        end
        if not alive() then return end
        local label, editable
        local nativeOK = false
        if not forcePortable then
            nativeOK = pcall(function()
                editable = AssetService:CreateEditableImage({Size=Vector2.new(data.Width,data.Height)})
                assert(editable, "EditableImage budget unavailable")
                editable:WritePixelsBuffer(Vector2.zero, Vector2.new(data.Width,data.Height), pixels)
                label = Instance.new("ImageLabel")
                label.Name = "ApprovedCatchPicture"; label.Size = UDim2.fromScale(1,1)
                label.BackgroundTransparency = 1; label.ScaleType = Enum.ScaleType.Fit
                label.ImageColor3 = known==false and Color3.fromRGB(37,54,65) or Color3.new(1,1,1)
                label.ImageContent = Content.fromObject(editable); label.ZIndex = 3; label.Parent = root
            end)
        end
        if nativeOK then
            state.Image = editable; state.Mode = "EditableImage"
        else
            if label then label:Destroy() end
            if editable then editable:Destroy() end
            local fallbackOK, fallback = pcall(makeFallback, root, data, pixels, alive, known)
            if not alive() then return end
            if fallbackOK and fallback then state.Mode = "PortablePicture"
            else
                state.Mode = "error"
                warn("[QuietCove] Portrait fallback failed: " .. species .. ": " .. tostring(fallback))
            end
        end
        if alive() then root:SetAttribute("Renderer",state.Mode); state.Ready=true end
    end)
    return state
end
return Sprite
]]></ProtectedString>
