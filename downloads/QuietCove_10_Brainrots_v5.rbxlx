			<Item class="ModuleScript" referent="RBXQC025_00001">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Original, asset-free models. Used by server tools/boats and client shop previews.
local Models={}
local function rgb(t)return Color3.fromRGB(t[1],t[2],t[3])end
local function part(parent,name,size,cf,color,material,class)
    local p=Instance.new(class or "Part");p.Name=name;p.Size=size;p.CFrame=cf
    p.Color=rgb(color);p.Material=material or Enum.Material.SmoothPlastic
    p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
    p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
    return p
end
local function weld(root,p)
    local w=Instance.new("WeldConstraint");w.Part0=root;w.Part1=p;w.Parent=p
end
local function finish(root,parent,preview)
    for _,p in ipairs(parent:GetDescendants())do
        if p:IsA("BasePart")then
            p.Anchored=preview==true
            if p~=root then weld(root,p)end
        end
    end
end
function Models.Rod(id,preview)
    local tool=Instance.new("Tool");tool.Name="Удочка";tool.CanBeDropped=false
    tool.ToolTip="ЛКМ — рыбалка · ПРОБЕЛ — прыжок"
    tool:SetAttribute("QuietCoveRod",true);tool:SetAttribute("RodStyle",id)
    local wood=id=="wood";local carbon=id=="carbon";local astral=id=="astral"
    local base=wood and {111,82,55} or (carbon and {76,81,91} or {29,69,102})
    local trim=wood and {194,159,92} or (carbon and {185,190,198} or {108,240,222})
    if astral then base={206,212,231};trim={214,112,246} end
    -- The grip is near the butt, never in the middle of a 5.4-stud shaft.
    local h=part(tool,"Handle",Vector3.new(wood and 0.24 or 0.27,0.50,wood and 0.24 or 0.27),CFrame.new(),base,
        wood and Enum.Material.Wood or Enum.Material.SmoothPlastic)
    local top=3.95
    if wood then
        part(tool,"WoodBlank",Vector3.new(0.17,3.70,0.17),CFrame.new(0,2.10,0),base,Enum.Material.Wood)
    else
        for i=1,4 do
            local width=0.21-i*0.032
            local y=0.26+(i-0.5)*0.84
            part(tool,"TaperedBlank"..i,Vector3.new(width,0.86,width),CFrame.new(0,y,0),base,Enum.Material.Metal)
            part(tool,"BlankBand"..i,Vector3.new(width+0.03,0.07,width+0.03),CFrame.new(0,y-0.3,0),trim,Enum.Material.Metal)
        end
        local tip=part(tool,"PointedTip",Vector3.new(0.12,0.45,0.10),CFrame.new(0,3.85,0)*CFrame.Angles(0,0,math.pi),trim,
            carbon and Enum.Material.Metal or Enum.Material.Neon,"WedgePart")
        if not carbon then
            for _,side in ipairs({-1,1})do
                part(tool,"TideFork",Vector3.new(0.14,1.1,0.16),CFrame.new(side*0.23,3.15,0)*CFrame.Angles(0,0,-side*0.23),trim,Enum.Material.Neon,"WedgePart")
            end
            local gem=part(tool,"TideCrystal",Vector3.new(0.32,0.38,0.32),CFrame.new(0,0.12,0)*CFrame.Angles(0,math.pi/4,0),trim,Enum.Material.Neon,"WedgePart")
            local light=Instance.new("PointLight");light.Color=rgb(trim);light.Brightness=0.6;light.Range=4;light.Parent=gem
        end
        for i=0,5 do
            part(tool,"GripWrap",Vector3.new(0.30,0.055,0.30),CFrame.new(0,-0.20+i*0.10,0),{37,42,47})
        end
    end
    if astral then
        for _,side in ipairs({-1,1})do
            part(tool,"AstralStar",Vector3.new(0.16,0.9,0.2),CFrame.new(side*0.2,3.25,0)*CFrame.Angles(0,0,side*0.6),trim,Enum.Material.Neon,"WedgePart")
        end
    end
    local seat=part(tool,"ReelSeat",Vector3.new(0.30,0.30,0.30),CFrame.new(0,0.15,0),trim,Enum.Material.Metal)
    seat.Shape=Enum.PartType.Cylinder
    local reel=part(tool,"ReelBody",Vector3.new(0.44,0.52,0.52),CFrame.new(0.28,0.15,0),wood and {53,69,86} or base,Enum.Material.Metal)
    reel.Shape=Enum.PartType.Cylinder
    local spool=part(tool,"Spool",Vector3.new(0.47,0.32,0.32),CFrame.new(0.28,0.15,0),trim,Enum.Material.Metal)
    spool.Shape=Enum.PartType.Cylinder
    part(tool,"ReelCrank",Vector3.new(0.10,0.32,0.10),CFrame.new(0.56,0.16,0),trim,Enum.Material.Metal)
    local knob=part(tool,"HandleKnob",Vector3.new(0.18,0.18,0.18),CFrame.new(0.56,0,0),base);knob.Shape=Enum.PartType.Ball
    if wood then local orb=part(tool,"TipOrb",Vector3.new(0.19,0.19,0.19),CFrame.new(0,top-0.05,0),{111,240,227},Enum.Material.Neon);orb.Shape=Enum.PartType.Ball end
    local tip=Instance.new("Attachment");tip.Name="Tip";tip.Position=Vector3.new(0,top,0);tip.Parent=h
    local right=Instance.new("Attachment");right.Name="CastMainGrip"
    right.CFrame=CFrame.new(0,-0.25,0)*CFrame.Angles(0,0,math.rad(-65));right.Parent=h
    local left=Instance.new("Attachment");left.Name="CastSupportGrip"
    -- The left support hand is ahead of the right main/reel hand.
    left.CFrame=CFrame.new(0,0.25,0)*CFrame.Angles(0,0,math.rad(65));left.Parent=h
    -- Native one-hand carry: a small outward offset keeps the reel/crystal
    -- outside the thigh even with a small avatar's arm hanging down.
    tool.Grip=CFrame.new(-0.14,-0.25,0)
    finish(h,tool,preview)
    return tool
end
function Models.Boat(def,preview)
    local model=Instance.new("Model");model.Name=def.Name
    local cat=def.Id=="catamaran";local skiff=def.Id=="skiff"
    local length=cat and 23 or (skiff and 14 or (def.Id=="motor" and 17 or 21))
    local width=cat and 15 or (skiff and 7 or 9)
    local root=part(model,"Hull",Vector3.new(width,1.8,length),CFrame.new(),def.Color,skiff and Enum.Material.WoodPlanks or Enum.Material.Metal)
    root.Massless=false;root.CanCollide=true;root.CanTouch=true;root.CanQuery=true
    -- The hull is low-density; a Y-only constraint stabilises its waterline.
    root.CustomPhysicalProperties=PhysicalProperties.new(0.45,0.3,0.05,1,1)
    model.PrimaryPart=root
    local function add(name,size,x,y,z,color,material,class)
        return part(model,name,size,CFrame.new(x,y,z),color,material,class)
    end
    add("TeakDeck",Vector3.new(width-0.7,0.22,length-1),0,1,0,skiff and {178,132,83} or {209,193,155},Enum.Material.WoodPlanks)
    if cat then
        root.Transparency=1
        for _,side in ipairs({-1,1})do
            add("Pontoon",Vector3.new(3.3,2.6,length),side*5.8,-0.1,0,def.Color,Enum.Material.Metal)
            add("PontoonBow",Vector3.new(3.3,2.6,4),side*5.8,-0.1,-length/2-2,def.Color,Enum.Material.Metal,"WedgePart")
        end
    else
        add("PointedBow",Vector3.new(width,1.8,3.5),0,0,-length/2-1.7,def.Color,root.Material,"WedgePart")
    end
    for _,side in ipairs({-1,1})do
        add("Gunwale",Vector3.new(0.40,1.1,length),side*(width/2-0.15),1.35,0,def.Color,root.Material)
        add("AccentRail",Vector3.new(0.44,0.15,length-0.4),side*(width/2-0.12),1.94,0,def.Accent,
            cat and Enum.Material.Neon or Enum.Material.SmoothPlastic)
        if skiff then
            local oar=add("OarShaft",Vector3.new(0.2,0.2,10),side*4.5,1.6,1,{164,118,63},Enum.Material.Wood)
            oar.CFrame=oar.CFrame*CFrame.Angles(0,side*0.68,0)
            add("OarBlade",Vector3.new(1,0.2,2.1),side*7.1,1.6,4.2,{177,132,77},Enum.Material.Wood)
        end
    end
    local seat=part(model,"PilotSeat",Vector3.new(2.4,0.65,2.2),CFrame.new(0,1.5,skiff and 1.8 or -0.1),{38,45,53},nil,"VehicleSeat")
    seat.HeadsUpDisplay=false;seat.CanTouch=true;seat.CanCollide=true;seat.CanQuery=true
    seat.MaxSpeed=0;seat.Torque=0;seat.TurnSpeed=0 -- Controller uses modern constraints, not wheel hinges.
    seat:SetAttribute("QuietCoveBoatSeat",true)
    add("SeatBack",Vector3.new(2.4,1.9,0.3),0,2.3,skiff and 2.9 or 1,{38,45,53})
    if skiff then
        add("FrontBench",Vector3.new(6,0.42,1.8),0,1.55,-3,def.Accent,Enum.Material.Wood)
    else
        add("Console",Vector3.new(3.8,1.6,1.2),0,1.9,-2.1,def.Color,Enum.Material.Metal)
        local screen=add("Windshield",Vector3.new(6,1.7,0.22),0,3.1,-2.5,{144,219,235},Enum.Material.Glass)
        screen.Transparency=0.45;screen.CFrame=screen.CFrame*CFrame.Angles(-0.2,0,0)
        for _,side in ipairs({-1,1})do
            add("Outboard",Vector3.new(1.5,2.4,1.8),side*(cat and 4.7 or 2.2),0.2,length/2+0.3,{42,48,56},Enum.Material.Metal)
            add("NavigationLight",Vector3.new(0.33,0.22,1.2),side*(width/2-0.2),2,-length/2+1,def.Accent,Enum.Material.Neon)
        end
        if cat or def.Id=="cutter" then
            for _,side in ipairs({-1,1})do add("CanopyPole",Vector3.new(0.15,3.4,0.15),side*3,3,2.2,def.Accent,Enum.Material.Metal)end
            add("Canopy",Vector3.new(7.5,0.25,5.7),0,4.75,0.8,def.Color)
            add("Antenna",Vector3.new(0.10,2.4,0.10),2,6,1,def.Accent,Enum.Material.Metal)
        end
    end
    finish(root,model,preview)
    return model
end
return Models
]]></ProtectedString>
					<string name="ScriptGuid">{A0A14444-2AB7-466C-931C-5FD8FC3FFB48}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EquipmentModels</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000065b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC025_00002">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Pure logic, separately testable. No reward or motion values are trusted from clients.
local Rules={}
local function finite(x)return type(x)=="number" and x==x and x>-math.huge and x<math.huge end
function Rules.Input(value)
    if type(value)~="table" or not finite(value.Throttle) or not finite(value.Steer) then return nil end
    return math.max(-1,math.min(1,value.Throttle)),math.max(-1,math.min(1,value.Steer))
end
function Rules.CanBuy(config,data,id)
    if type(id)~="string" or #id>32 then return false,"Неизвестная лодка." end
    local def=config.BoatById[id]
    if not data or not def then return false,"Лодка недоступна." end
    if data.OwnedBoats and data.OwnedBoats[id]then return false,"Эта лодка уже куплена." end
    if not data.TestMode and config.Level(data.XP)<def.Level then return false,"Нужен уровень "..def.Level.."." end
    if not data.TestMode and data.Coins<def.Price then return false,"Не хватает "..(def.Price-data.Coins).." монет." end
    return true
end
function Rules.Step(speed,yaw,throttle,steer,dt,def)
    dt=math.max(0,math.min(0.1,dt))
    local target=throttle*def.Speed*(throttle<0 and 0.4 or 1)
    local delta=math.max(-def.Acceleration*dt,math.min(def.Acceleration*dt,target-speed))
    speed=speed+delta
    local response=math.max(0.22,math.min(1,math.abs(speed)/def.Speed))
    yaw=yaw-steer*def.Turn*response*dt*(speed<-0.5 and -1 or 1)
    yaw=(yaw+math.pi)%(math.pi*2)-math.pi
    return speed,yaw
end
return Rules
]]></ProtectedString>
					<string name="ScriptGuid">{DCBDE81C-EC50-4E5D-936A-5A4D29C55D80}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">BoatRules</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000065c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC026_00001">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- One presentation clock: the release marker lives INSIDE the forward stroke.
-- Authoritative water destination/timing; no rewards and no client decisions here.
local Cast={}
local function clamp(x,a,b)return math.max(a,math.min(b,x))end
function Cast.Smooth(t)t=clamp(t,0,1);return t*t*t*(t*(t*6-15)+10)end
-- Reachable grips ahead of the body, short butt behind the right hand.
local REST={X=.15,Y=.10,Z=-1.65,Pitch=-65,Yaw=0,Roll=0,Lean=-4,Twist=0,Drop=.02,ShiftX=0,ShiftZ=0}
local function lerp(a,b,t)local out={};for k,v in pairs(a)do out[k]=v+(b[k]-v)*t end;return out end
local function charged(power)
    -- Loading stays upright/slightly forward; a backward shaft cuts through the head.
    local back={X=.25,Y=.68,Z=-1.10,Pitch=-8,Yaw=-8,Roll=0,Lean=2,Twist=-6,Drop=.03,ShiftX=.01,ShiftZ=0}
    return lerp(REST,back,Cast.Smooth(power))
end
-- Time-aware cubic Hermite spline. Internal velocities are continuous, including release.
local function spline(keys,time)
    local idx=1
    while idx<#keys-1 and time>keys[idx+1].T do idx=idx+1 end
    local a,b=keys[idx],keys[idx+1];local span=b.T-a.T
    local u=clamp((time-a.T)/span,0,1);local u2,u3=u*u,u*u*u
    local prev=keys[math.max(1,idx-1)];local after=keys[math.min(#keys,idx+2)]
    local out={}
    for k,v in pairs(a.P)do
        local m0=idx==1 and 0 or (b.P[k]-prev.P[k])/(b.T-prev.T)*0.68
        local m1=idx+1==#keys and 0 or (after.P[k]-a.P[k])/(after.T-a.T)*0.68
        out[k]=(2*u3-3*u2+1)*v+(u3-2*u2+u)*span*m0+(-2*u3+3*u2)*b.P[k]+(u3-u2)*span*m1
    end
    return out
end
function Cast.Frame(stage,elapsed,power,config)
    power=clamp(power or 0,0,1)
    local out=lerp(REST,REST,0)
    if stage=='Charging' then out=charged(power)
    elseif stage=='Casting' then
        local start=charged(power)
        local load=lerp(start,start,0);load.Pitch=math.min(-3,load.Pitch+4);load.Twist=load.Twist-2
        local follow={X=.15,Y=.06,Z=-1.78,Pitch=-77,Yaw=0,Roll=0,Lean=-8,Twist=4,Drop=.04,ShiftX=0,ShiftZ=-.04}
        out=spline({{T=0,P=start},{T=.08,P=load},{T=config.StrokeEndSeconds or .54,P=follow},
            {T=config.SettleSeconds or 1.10,P=REST}},elapsed)
    elseif stage=='Waiting' then out.Pitch=out.Pitch+math.sin(elapsed*1.55)*.85
    elseif stage=='Bite' then out.Pitch=out.Pitch+math.sin(elapsed*10)*1.4
    elseif stage=='Reeling' then out.Pitch=-61+math.sin(elapsed*3.5)*1.0;out.Lean=-6;out.Drop=.035
    elseif stage=='Landing' then out.Pitch=-52;out.Y=.22;out.Lean=-3;out.Drop=.025
    end
    out.Slash=stage=='Casting' and elapsed>=.11 and elapsed<=.60
    return out
end
function Cast.RodFrame(frame)
    return CFrame.new(frame.X,frame.Y,frame.Z)*CFrame.Angles(0,math.rad(frame.Yaw),0)*CFrame.Angles(math.rad(frame.Pitch),0,math.rad(frame.Roll))
end
function Cast.Release(root,tip,power,config)
    local t=config.SwingSeconds
    local before=root*Cast.RodFrame(Cast.Frame('Casting',t-.005,power,config))*tip
    local now=root*Cast.RodFrame(Cast.Frame('Casting',t,power,config))*tip
    local direction=(now-before).Magnitude>.001 and (now-before).Unit or root.LookVector
    return now,direction,(now-before)/.005
end
function Cast.Position(origin,target,t,height,direction,velocity,flight)
    t=clamp(t,0,1)
    local delta=target-origin;local length=delta.Magnitude
    local launch=direction or (delta+Vector3.new(0,height*2,0)).Unit
    local a=origin+(velocity and velocity*((flight or 1)/3)or launch*(length*.39)) -- matches tip speed at release
    local b=target-delta*.22+Vector3.new(0,height,0)
    local u=1-t
    return origin*(u*u*u)+a*(3*u*u*t)+b*(3*u*t*t)+target*(t*t*t)
end
function Cast.Timing(power,config)
    power=clamp(power,0,1)
    return config.SwingSeconds,config.FlightSeconds+power*config.ExtraFlightSeconds,config.ArcHeight+power*config.ExtraArcHeight
end
function Cast.Progress(now,started,swing,flight)return clamp((now-started-swing)/math.max(.1,flight),0,1)end
-- Legacy consumers can inspect scalar pose values, but CastingRig solves actual grip targets.
function Cast.Pose(stage,t,power,config)
    local f=Cast.Frame(stage,t,power,config)
    return {Right=76,Left=60,Twist=f.Twist,Lean=f.Lean,Elbow=30,Wrist=0,Grip=0,Slash=f.Slash}
end
return Cast
]]></ProtectedString>
					<string name="ScriptGuid">{4C3A37DF-7A72-4587-826E-89FB52634F91}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CastMath</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000065d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC027_000001">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Server-resolved settings; outcome is decided by Reel.step, never by a success dice roll.
local Balance={}
function Balance.Resolve(config,fish,rod)
    local tuning={}
    for k,v in pairs(config.Reeling)do tuning[k]=v end
    local width=rod.Width
    local family=(config.SpeciesFights or {})[fish.Id]
    local quality=rod.Quality or 1
    local overrides=family and (family[quality] or family.Default)
    if overrides then
        for k,v in pairs(overrides)do if k=='Width' then width=v else tuning[k]=v end end
    end
    return {Width=width,Resilience=rod.Resilience,Difficulty=fish.Difficulty,
        Pattern=fish.Pattern,Tuning=tuning,Quality=quality}
end
return Balance
]]></ProtectedString>
					<string name="ScriptGuid">{8FF25B1C-DEDC-4915-8D66-5A87855B3683}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">FightBalance</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000065e</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC027_000002">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Pure transaction logic. A won fish is reserved during Landing; the SERVER commits it.
-- A saved reservation can be recovered on load. No client completion event is trusted.
local Ledger={}
local function normalized(config,record)
    if type(record)~='table' then return nil end
    local fish=config.ById[record.Species]
    if not fish or type(record.Kg)~='number' or record.Kg~=record.Kg then return nil end
    local kg=math.max(fish.MinKg,math.min(fish.MaxKg,record.Kg))
    local mutation=(record.Mutation=='gold' or record.Mutation=='glow')and record.Mutation or 'normal'
    return {Species=fish.Id,Kg=kg,Mutation=mutation,Value=config.Value(fish,kg,mutation)}
end
function Ledger.Reserve(data,config,record,token)
    if type(token)~='string' or #token==0 or #token>128 then return false end
    if data.PendingCatch or data.LastCatchToken==token or #data.Bag>=config.BagCapacity then return false end
    local safe=normalized(config,record);if not safe then return false end
    data.PendingCatch={Token=token,Record=safe};return true
end
function Ledger.Commit(data,config,expectedToken)
    local pending=data.PendingCatch
    if type(pending)~='table' then return nil end
    if expectedToken and pending.Token~=expectedToken then return nil end
    if type(pending.Token)~='string' or pending.Token==data.LastCatchToken then data.PendingCatch=nil;return nil end
    local r=normalized(config,pending.Record)
    if not r then data.PendingCatch=nil;return nil end
    if #data.Bag>=config.BagCapacity then return nil end -- retain, don't destroy an earned catch
    local fish=config.ById[r.Species]
    local before=config.Level(data.XP)
    local fresh=not data.Bestiary[r.Species]
    -- This block contains no yield; only a validated reservation can be committed once.
    data.PendingCatch=nil;data.LastCatchToken=pending.Token
    table.insert(data.Bag,r);data.Bestiary[r.Species]=true
    data.XP=math.min(100000000,data.XP+fish.XP)
    data.TotalCaught=math.min(100000000,data.TotalCaught+1)
    return {Record=r,New=fresh,XP=fish.XP,LevelUp=not data.TestMode and config.Level(data.XP)>before,Token=pending.Token}
end
function Ledger.Recover(data,config,raw)
    data.LastCatchToken=type(raw.LastCatchToken)=='string'and raw.LastCatchToken or nil
    local p=raw.PendingCatch
    if type(p)=='table'and type(p.Token)=='string'and #p.Token<=128 then
        local r=normalized(config,p.Record)
        if r then data.PendingCatch={Token=p.Token,Record=r};return Ledger.Commit(data,config) end
    end
end
return Ledger
]]></ProtectedString>
					<string name="ScriptGuid">{33198E18-24B6-4FE0-97D1-4F35F27A9591}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CatchLedger</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000065f</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC027_000003">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Native, editable 3D templates. No billboard, external mesh or asset download.
local shared=game:GetService('ReplicatedStorage'):WaitForChild('QuietCove')
local templates=shared:WaitForChild('CreatureAssets')
local Models={}
function Models.Has(id)return type(id)=='string'and templates:FindFirstChild(id)~=nil end
function Models.Create(id,parent,mutation)
    local source=templates:FindFirstChild(id);if not source then return nil end
    local model=source:Clone();model.Name='Caught_'..id;model.Parent=parent
    for _,p in ipairs(model:GetDescendants())do
        if p:IsA('BasePart')then p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false end
    end
    if mutation=='gold' or mutation=='glow' then
        local light=Instance.new('Highlight');light.Name='MutationAccent';light.Adornee=model
        light.FillColor=mutation=='gold'and Color3.fromRGB(255,211,77)or Color3.fromRGB(148,249,236)
        light.FillTransparency=.76;light.OutlineColor=light.FillColor;light.OutlineTransparency=.35;light.Parent=model
    end
    return model
end
function Models.Bind(model)
    local binding={Parts={},Groups={}}
    local origin=model:GetPivot()
    for _,p in ipairs(model:GetDescendants())do if p:IsA('BasePart')then
        binding.Parts[#binding.Parts+1]={Part=p,Alpha=p.Transparency}
    end end
    for _,g in ipairs(model:GetChildren())do if g:IsA('Model')then
        binding.Groups[#binding.Groups+1]={Model=g,Name=g.Name,Base=origin:Inverse()*g:GetPivot()}
    end end
    return binding
end
function Models.Animate(model,binding,frame,time,fade)
    model:PivotTo(frame)
    for _,g in ipairs(binding.Groups)do
        local offset=CFrame.new()
        if g.Name=='Tail' then offset=CFrame.Angles(0,math.sin(time*7.5)*.17,0)
        elseif g.Name=='FinL' then offset=CFrame.Angles(0,0,math.sin(time*5)*.10)
        elseif g.Name=='FinR' then offset=CFrame.Angles(0,0,-math.sin(time*5)*.10)
        elseif g.Name=='Orbit' then offset=CFrame.Angles(.28,time*.75,.15)
        elseif string.sub(g.Name,1,4)=='Prop' then offset=CFrame.Angles(0,0,time*19)end
        g.Model:PivotTo(frame*g.Base*offset)
    end
    fade=math.clamp(fade or 0,0,1)
    if binding.LastFade~=fade then
        for _,p in ipairs(binding.Parts)do p.Part.Transparency=p.Alpha+(1-p.Alpha)*fade end
        binding.LastFade=fade
    end
end
return Models
]]></ProtectedString>
					<string name="ScriptGuid">{5C74E62F-5F3F-4601-B942-9B544F5BFEA6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
