				<Item class="ModuleScript" referent="RBXQC024Portraitambalabu">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Supplied ambalabu portrait; RGB palette + RLE and separate lossless alpha.
return {
    Width = 320, Height = 320,
    Palette = {
        0xFFFFFFFF, 0xFFEFFFFF, 0xFFFFFFCE, 0xFFE9EBE7, 0xFFB9EAF0, 0xFF2AFCFA, 0xFFA7DBEC, 0xFF71DACC,
        0xFFA8D0E9, 0xFF9CC2E4, 0xFFA5CDC7, 0xFFA9BDC7, 0xFF5CCED9, 0xFF64BEDA, 0xFF61CAC0, 0xFF58BCBE,
        0xFF7DB0DF, 0xFF7DADD1, 0xFFA0AFC2, 0xFF72ABC6, 0xFF71A2CC, 0xFF6B99C8, 0xFF6E9CBC, 0xFF6893B8,
        0xFF4FAADE, 0xFF46AAC5, 0xFF46AFBB, 0xFF45A4BB, 0xFF4A95CF, 0xFF4D93BF, 0xFF4D97B9, 0xFF528DB8,
        0xFF86CBAD, 0xFF5EBEAA, 0xFF76B3AB, 0xFF40B3AA, 0xFF73BD9D, 0xFFA2D076, 0xFF80B091, 0xFF47B098,
        0xFF9CA4A7, 0xFF5AA5A6, 0xFF37A3AC, 0xFF3BA49C, 0xFF6DA58D, 0xFF40A48D, 0xFF62A382, 0xFF6EA175,
        0xFF8992A2, 0xFF658DAE, 0xFF5E8CAF, 0xFF5D88AD, 0xFF3B96A9, 0xFF35969B, 0xFF4A8AAF, 0xFF358C9B,
        0xFF739288, 0xFF439385, 0xFF2E9388, 0xFF288989, 0xFF609275, 0xFF618E68, 0xFF3E9375, 0xFF388972,
        0xFF397FCF, 0xFF4B83B0, 0xFF5A84AA, 0xFF4A80AA, 0xFF5B81A5, 0xFF627F9B, 0xFF537DA2, 0xFF37809B,
        0xFF2F75B6, 0xFF3E76A2, 0xFF537598, 0xFF407295, 0xFF2B69AB, 0xFF356A95, 0xFF215C9C, 0xFF1D5398,
        0xFF9B8082, 0xFF7F7F7F, 0xFF7A797F, 0xFF48817C, 0xFF5E737F, 0xFF168183, 0xFF288276, 0xFF267B7E,
        0xFF24727D, 0xFF516983, 0xFF476280, 0xFF26677F, 0xFF315E7F, 0xFF215685, 0xFF2F5675, 0xFF1A4D86,
        0xFF1B4A78, 0xFF647762, 0xFF457C61, 0xFF347E67, 0xFF33715D, 0xFF247A6A, 0xFF227561, 0xFF1F6D65,
        0xFF1E6C5A, 0xFF656266, 0xFF5B5A61, 0xFF206562, 0xFF205D60, 0xFF535E4D, 0xFF2E604B, 0xFF1A6253,
