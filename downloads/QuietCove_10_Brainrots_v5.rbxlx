<Item class="ModuleScript" referent="RBX_QCEXP_CatchPresentation"><Properties><string name="Name">CatchPresentation</string><ProtectedString name="Source"><![CDATA[-- Presentation sizes in studs. ScaleTo takes an absolute Model scale.
local Presentation = {LandingSizes = {capybara = 2.0}}

function Presentation.LandingSize(species, rarity)
    return Presentation.LandingSizes[species] or (rarity >= 5 and 5.0 or 3.3 + rarity * .16)
end

function Presentation.ScaleLanding(model, species, rarity)
    local _, size = model:GetBoundingBox()
    local extent = math.max(size.X, size.Y, size.Z)
    assert(extent > 0, "Catch model has no size: " .. tostring(species))
    local desired = Presentation.LandingSize(species, rarity)
    model:ScaleTo(model:GetScale() * desired / extent)
    return desired
end

return Presentation
]]></ProtectedString></Properties></Item>

<Item class="ModuleScript" referent="RBX_QCEXP_RodClearance"><Properties><string name="Name">RodClearance</string><ProtectedString name="Source"><![CDATA[-- Conservative compound OBB clearance: all visible rod parts vs body boxes.
-- Hands/arms are excluded because the grips intentionally touch them.
local Clearance={}
local bodyNames={Torso=true,UpperTorso=true,LowerTorso=true,Head=true,
    ['Right Leg']=true,['Left Leg']=true,RightUpperLeg=true,LeftUpperLeg=true,
    RightLowerLeg=true,LeftLowerLeg=true,RightFoot=true,LeftFoot=true}

function Clearance.Describe(model,handle)
    local shapes={}
    for _,part in ipairs(model:GetDescendants())do
        if part:IsA('BasePart') and part.Transparency<1 then
            shapes[#shapes+1]={Local=handle.CFrame:ToObjectSpace(part.CFrame),Half=part.Size*.5,Name=part.Name}
        end
    end
    return shapes
end
function Clearance.BodyParts(character)
    local parts={}
    for _,part in ipairs(character:GetChildren())do
        if part:IsA('BasePart') and bodyNames[part.Name]then parts[#parts+1]=part end
    end
    return parts
end

local axes={Vector3.xAxis,Vector3.yAxis,Vector3.zAxis}
function Clearance.Overlap(a,ah,b,bh,margin)
    -- SAT in the body box frame: 3 body axes, 3 rod axes and 9 cross axes.
    local relative=b:ToObjectSpace(a)
    local centre=relative.Position
    local ra={relative.RightVector,relative.UpVector,-relative.LookVector}
    local rh={ah.X,ah.Y,ah.Z}
    local half={bh.X+(margin or 0),bh.Y+(margin or 0),bh.Z+(margin or 0)}
    local function separated(axis)
        if axis:Dot(axis)<1e-10 then return false end
        -- Normalize cross axes so the tolerance remains in world studs.
        axis=axis.Unit
        local rodRadius=0
        for i=1,3 do rodRadius+=rh[i]*math.abs(ra[i]:Dot(axis))end
        local bodyRadius=half[1]*math.abs(axis.X)+half[2]*math.abs(axis.Y)+half[3]*math.abs(axis.Z)
        return math.abs(centre:Dot(axis))>=rodRadius+bodyRadius-1e-5
    end
    for _,axis in ipairs(axes)do if separated(axis)then return false end end
    for _,axis in ipairs(ra)do if separated(axis)then return false end end
    for _,axis in ipairs(axes)do for _,other in ipairs(ra)do
        if separated(axis:Cross(other))then return false end
    end end
    return true
end
function Clearance.Check(frame,shapes,bodies,world,margin)
    for _,body in ipairs(bodies)do
        local cf=world(body);local half=body.Size*.5
        for _,shape in ipairs(shapes)do
            if Clearance.Overlap(frame*shape.Local,shape.Half,cf,half,margin)then return false,shape.Name,body.Name end
        end
    end
    return true
end
return Clearance
]]></ProtectedString></Properties></Item>

<Item class="ModuleScript" referent="RBX_QCEXP_StudioPreview"><Properties><string name="Name">StudioPreview</string><ProtectedString name="Source"><![CDATA[-- Explicit Command Bar endpoints work across require caches/VMs.
-- Server Studio commands only send presentation requests to a selected client.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local shared=script.Parent
local Preview={}
local actions={Catch=true,World=true,Portrait=true,All=true,Stop=true,Rod=true}
local mutations={normal=true,gold=true,glow=true}

local function studio()
    assert(RunService:IsStudio(),"Просмотр доступен только в Roblox Studio.")
end
local function config()return require(shared:WaitForChild("Config"))end

function Preview.Attach(context)
    studio()
    assert(RunService:IsClient(),"Preview.Attach must run on the game client")
    local core=require(shared:WaitForChild("StudioPreviewClient"))
    core.Attach(context)
    local scripts=Players.LocalPlayer:WaitForChild("PlayerScripts")
    local old=scripts:FindFirstChild("QuietCoveStudioPreview")
    if old then old:Destroy()end
    local endpoint=Instance.new("BindableFunction")
    endpoint.Name="QuietCoveStudioPreview"
    endpoint.OnInvoke=function(action,...)
        assert(actions[action],"Unknown Studio preview command")
        return core[action](core,...)
    end
    endpoint.Parent=scripts
    local connection=shared:WaitForChild("StudioPreviewCommand").OnClientEvent:Connect(function(action,...)
        if not actions[action]then return end
        local ok,result=pcall(endpoint.Invoke,endpoint,action,...)
        if not ok then warn("[QuietCove preview] "..tostring(result))end
    end)
    context.Gui.Destroying:Connect(function()connection:Disconnect();endpoint:Destroy()end)
end

local function dispatch(action,args,playerName)
    studio()
    assert(RunService:IsRunning(),"Сначала нажми Play. Команды показывают анимацию в запущенной игре.")
    if RunService:IsClient()then
        local localPlayer=assert(Players.LocalPlayer,"Клиент ещё загружается")
        local scripts=localPlayer:WaitForChild("PlayerScripts")
        local endpoint=scripts:WaitForChild("QuietCoveStudioPreview",10)
        assert(endpoint,"Клиент Quiet Cove не загрузился. Проверь ошибки в Output и повтори Play.")
        return endpoint:Invoke(action,table.unpack(args,1,args.n))
    end
    local list=Players:GetPlayers()
    local target
    if playerName then target=Players:FindFirstChild(playerName)
    elseif #list==1 then target=list[1]
    else error("Укажи имя игрока последним аргументом команды; в тесте несколько игроков.")end
    assert(target,"В тесте ещё нет игрока. Нажми Play и дождись появления персонажа.")
    shared:WaitForChild("StudioPreviewCommand"):FireClient(target,action,table.unpack(args,1,args.n))
    return true
end

local function species(id,mutation)
    studio()
    assert(type(id)=="string" and config().ById[id],"Неизвестный ID рыбы. Список: :List()")
    mutation=mutation or "normal"
    assert(mutations[mutation],"Мутация: normal, gold или glow")
    return mutation
end
function Preview:List()
    studio()
    local c=config();local ids={}
    for _,fish in ipairs(c.Fish)do
        ids[#ids+1]=fish.Id
        print(fish.Id.." — "..fish.Name.." — "..c.Rarities[fish.Rarity].Name)
    end
    return ids
end
function Preview:Catch(id,mutation,playerName)
    return dispatch("Catch",table.pack(id,species(id,mutation)),playerName)
end
function Preview:World(id,mutation,playerName)
    return dispatch("World",table.pack(id,species(id,mutation)),playerName)
end
function Preview:Portrait(id,mutation,playerName)
    return dispatch("Portrait",table.pack(id,species(id,mutation)),playerName)
end
function Preview:All(mode,mutation,playerName)
    mode=mode or "catch";mutation=mutation or "normal"
    assert(mode=="catch" or mode=="world" or mode=="portrait","Режим: catch, world или portrait")
    assert(mutations[mutation],"Мутация: normal, gold или glow")
    return dispatch("All",table.pack(mode,mutation),playerName)
end
function Preview:Rod(stage,seconds,playerName)
    return dispatch("Rod",table.pack(stage or "Waiting",seconds or 6),playerName)
end
function Preview:Stop(playerName)return dispatch("Stop",table.pack(),playerName)end
return Preview
]]></ProtectedString></Properties></Item>

<Item class="ModuleScript" referent="RBX_QCEXP_StudioPreviewClient"><Properties><string name="Name">StudioPreviewClient</string><ProtectedString name="Source"><![CDATA[-- Client-only Studio presentation controls. Never award catches or send remotes.
local RunService = game:GetService("RunService")
local Preview = {}
local context
local serial = 0
local mutations = {normal = true, gold = true, glow = true}

local function client()
    assert(RunService:IsStudio(), "StudioPreview is available only in Roblox Studio.")
    assert(RunService:IsRunning() and RunService:IsClient(),
        "Start Play, select Client, then run the command in Command Bar.")
    assert(context and context.Alive(), "Quiet Cove client is still loading. Try again shortly.")
    return context
end

local function validate(species, mutation)
    local c = client()
    assert(type(species) == "string" and c.Config.ById[species], "Unknown species. Run :List() for IDs.")
    mutation = mutation or "normal"
    assert(mutations[mutation], "Mutation must be normal, gold, or glow.")
    return c, mutation
end

function Preview.Attach(value)
    if RunService:IsStudio() and RunService:IsClient() then context = value end
end

function Preview:List()
    local rows = {}
    local c = client()
    for _, fish in ipairs(c.Config.Fish) do
        rows[#rows + 1] = fish.Id
        print(fish.Id .. " — " .. fish.Name .. " — " .. c.Config.Rarities[fish.Rarity].Name)
    end
    return rows
end

function Preview:World(species, mutation)
    local c, variant = validate(species, mutation)
    assert(c.CanPreview(), "Finish fishing and close the bag/shop before previewing.")
    serial += 1
    c.HidePortrait()
    return c.World(species, variant)
end

function Preview:Portrait(species, mutation)
    local c, variant = validate(species, mutation)
    assert(c.CanPreview(), "Finish fishing and close the bag/shop before previewing.")
    serial += 1
    c.Portrait(species, variant)
    return true
end

local function catch(c, species, mutation, token)
    if not c.CanPreview() then return false end
    c.HidePortrait()
    if not c.World(species, mutation) then return false end
    local fish = c.Config.ById[species]
    task.delay(c.Config.Landing.DurationByRarity[fish.Rarity] + .08, function()
        if serial == token and c.Alive() and c.CanPreview() then c.Portrait(species, mutation) end
    end)
    return true
end

function Preview:Catch(species, mutation)
    local c, variant = validate(species, mutation)
    assert(c.CanPreview(), "Finish fishing and close the bag/shop before previewing.")
    serial += 1
    return catch(c, species, variant, serial)
end

function Preview:All(mode, mutation)
    local c = client()
    mode = mode or "catch"
    mutation = mutation or "normal"
    assert(mode == "catch" or mode == "world" or mode == "portrait", "Mode must be catch, world, or portrait.")
    assert(mutations[mutation], "Mutation must be normal, gold, or glow.")
    assert(c.CanPreview(), "Finish fishing and close the bag/shop before previewing.")
    serial += 1
    local token = serial
    task.spawn(function()
        for _, fish in ipairs(c.Config.Fish) do
            if serial ~= token or not c.Alive() or not c.CanPreview() then return end
            print("[QuietCove preview] " .. fish.Id .. " — " .. fish.Name)
            local duration = c.Config.Landing.DurationByRarity[fish.Rarity]
            if mode == "catch" then
                if not catch(c, fish.Id, mutation, token) then return end
                task.wait(duration + 5.0)
            elseif mode == "world" then
                c.HidePortrait()
                if not c.World(fish.Id, mutation) then return end
                task.wait(duration + .25)
            else
                c.Portrait(fish.Id, mutation)
                task.wait(5.0)
            end
        end
    end)
    return true
end

function Preview:Stop()
    local c = client()
    serial += 1
    c.ClearPreviews()
    c.HidePortrait()
end

function Preview:Rod(stage,seconds)
    local c=client()
    assert(c.CanPreview(),"Finish fishing and close the bag/shop before previewing.")
    serial+=1
    return c.Rod(stage or "Waiting",seconds or 6)
end
return Preview
]]></ProtectedString></Properties></Item>

<Item class="RemoteEvent" referent="RBX_QCEXP_StudioPreviewCommand"><Properties><string name="Name">StudioPreviewCommand</string></Properties></Item>
</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBXQC000173">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc000003cd</UniqueId>
		</Properties>
		<Item class="Folder" referent="RBXQC000174">
			<Properties>
				<Color3 name="IconTint">
					<R>0</R>
					<G>0</G>
					<B>0</B>
				</Color3>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">QuietCove</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc0000098c</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="RBXQC000175">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Asset-free, editable low-poly island. Build() can also be run from Studio's Command Bar.
local World = {}
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("QuietCove"):WaitForChild("Config"))
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local function part(parent, name, size, position, color, material)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position = name, size, position
    p.Anchored = true; p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
    p.Color = Color3.fromRGB(color[1], color[2], color[3])
    p.Material = material or Enum.Material.SmoothPlastic
    p.Parent = parent
    return p
end
local function label(parent, text, height, width)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"; gui.Size = UDim2.fromOffset(width or 260, 58)
    gui.StudsOffset = Vector3.new(0, height or 3, 0); gui.MaxDistance = 120
    gui.AlwaysOnTop = false; gui.Parent = parent
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1
    t.TextColor3 = Color3.fromRGB(248, 240, 216); t.TextStrokeTransparency = 0.25
    t.Font = Enum.Font.GothamBold; t.TextSize = 19; t.TextWrapped = true; t.Text = text; t.Parent = gui
end
local function prompt(parent, name, action, object)
    local p = Instance.new("ProximityPrompt")
    p.Name = name; p.ActionText = action; p.ObjectText = object
    p.KeyboardKeyCode = Enum.KeyCode.E; p.HoldDuration = 0.2
    p.MaxActivationDistance = 12; p.RequiresLineOfSight = false; p.Parent = parent
    return p
end
local function npc(parent, name, x, z, shirt, text, action)
    local model = Instance.new("Model"); model.Name = name; model.Parent = parent
    local body = part(model, "Body", Vector3.new(2.5, 2.8, 1.4), Vector3.new(x, 9.2, z), shirt)
    part(model, "Head", Vector3.new(1.7, 1.7, 1.7), Vector3.new(x, 11.4, z), {224, 181, 139})
    part(model, "Hat", Vector3.new(2.5, 0.35, 2.2), Vector3.new(x, 12.35, z), {53, 66, 65})
    for _, side in ipairs({-1, 1}) do
        part(model, "Arm", Vector3.new(0.65, 2.5, 1), Vector3.new(x + side * 1.65, 9.2, z), shirt)
        part(model, "Leg", Vector3.new(0.9, 1.5, 1.2), Vector3.new(x + side * 0.65, 7.15, z), {48, 59, 65})
        local eye = part(model, "Eye", Vector3.new(0.17, 0.17, 0.1), Vector3.new(x + side * 0.36, 11.55, z - 0.86), {28, 39, 48})
        eye.CanCollide = false
    end
    label(body, text, 5.5)
    prompt(body, name .. "Prompt", action, text)
    return body
end
local function palm(parent, x, z, height)
    local trunk = part(parent, "PalmTrunk", Vector3.new(1.8, height, 1.8), Vector3.new(x, 7 + height / 2, z), {136, 96, 62}, Enum.Material.Wood)
    trunk.CFrame = trunk.CFrame * CFrame.Angles(0, 0, math.rad(7))
    for i = 0, 5 do
        local a = i * math.pi / 3
        local leaf = part(parent, "PalmLeaf", Vector3.new(3.3, 0.65, 11), Vector3.new(x + math.sin(a) * 3.5, 7 + height, z + math.cos(a) * 3.5), {52, 126 + i * 4, 88}, Enum.Material.Grass)
        leaf.CFrame = CFrame.new(leaf.Position) * CFrame.Angles(0, a, math.rad(8))
        leaf.CanCollide = false
    end
end
local function refs(model)
    local reef = Config.IslandById.Reef
    return {
        Model = model,
        Merchant = model.Merchant.Body,
        Shop = model.Rodsmith.Body,
        Ferry = model.Ferry,
        ReturnFerry = model.ReturnFerry,
        Spawn = Vector3.new(0, 11, -19),
        ReefSpawn = Vector3.new(reef.X, 11, reef.Z - 20),
        Spots = {
            Cove = {Center = Vector3.new(0, 8, -99), Name = "Тихая бухта", Radius = 20},
            Reef = {Center = Vector3.new(reef.X, 8, reef.Z - 32), Name = "Коралловый риф", Radius = 17},
        },
    }
end
function World.Build()
    local reef = Config.IslandById.Reef
    local waterSize = (Config.Ocean.HalfExtent + 100) * 2
    Workspace.Terrain:FillBlock(CFrame.new(0, -14, 0), Vector3.new(waterSize, 28, waterSize), Enum.Material.Water)
    Workspace.Terrain.WaterColor = Color3.fromRGB(31, 139, 155)
    Workspace.Terrain.WaterTransparency = 0.25; Workspace.Terrain.WaterWaveSize = 0.18
    Workspace.Terrain.WaterWaveSpeed = 8
    Lighting.ClockTime = 11; Lighting.Brightness = 2.4
    Lighting.Ambient = Color3.fromRGB(92, 115, 128); Lighting.OutdoorAmbient = Color3.fromRGB(120, 144, 153)
    Lighting.FogColor = Color3.fromRGB(153, 208, 213); Lighting.FogStart = 900; Lighting.FogEnd = 2800
    local oceanPreview = Workspace:FindFirstChild("QuietCoveOceanPreview")
    if oceanPreview then oceanPreview:Destroy() end
    local existing = Workspace:FindFirstChild("QuietCoveMap")
    if existing then return refs(existing) end
    local preview = Workspace:FindFirstChild("StartHere")
    if preview then preview:Destroy() end
    local model = Instance.new("Model"); model.Name = "QuietCoveMap"; model.Parent = Workspace
    part(model, "IslandRock", Vector3.new(124, 16, 94), Vector3.new(0, -3, 0), {118, 139, 136}, Enum.Material.Rock)
    part(model, "IslandSand", Vector3.new(119, 2, 89), Vector3.new(0, 5, 0), {231, 215, 168}, Enum.Material.Sand)
    part(model, "IslandGrass", Vector3.new(99, 1, 68), Vector3.new(0, 6.5, 5), {89, 153, 108}, Enum.Material.Grass)
    part(model, "Path", Vector3.new(12, 0.2, 56), Vector3.new(0, 7.1, -5), {219, 201, 158}, Enum.Material.Sand)
    for i = 0, 19 do
        part(model, "PierPlank", Vector3.new(14, 1, 3.6), Vector3.new(0, 7, -36 - i * 3.65), {141, 106, 74}, Enum.Material.WoodPlanks)
    end
    part(model, "FishingPlatform", Vector3.new(28, 1, 18), Vector3.new(0, 7, -103), {159, 118, 79}, Enum.Material.WoodPlanks)
    for z = -39, -109, -14 do
        for _, x in ipairs({-6, 6}) do
            part(model, "PierSupport", Vector3.new(1.2, 13, 1.2), Vector3.new(x, 1.5, z), {107, 76, 54}, Enum.Material.Wood)
        end
    end
    local fishingSign = part(model, "FishingSign", Vector3.new(1, 4, 1), Vector3.new(-10, 9, -101), {106, 74, 55}, Enum.Material.Wood)
    label(fishingSign, "РЫБАЛКА\nЗажми и отпусти ЛКМ", 3, 300)
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "CoveSpawn"; spawn.Size = Vector3.new(8, 0.2, 8)
    spawn.Position = Vector3.new(0, 7.3, -19); spawn.Anchored = true; spawn.Neutral = true
    spawn.Duration = 0; spawn.Transparency = 1; spawn.CanCollide = false; spawn.Parent = model
    npc(model, "Merchant", -20, -25, {215, 155, 82}, "МАРА · ПРОДАЖА УЛОВА", "Продать весь улов")
    npc(model, "Rodsmith", 20, -25, {76, 139, 151}, "ЛЕВ · МАСТЕР УДОЧЕК", "Выбрать удочку")
    for _, x in ipairs({-20, 20}) do
        part(model, "ShopCounter", Vector3.new(10, 2.4, 3.3), Vector3.new(x, 7.3, -29), {114, 84, 65}, Enum.Material.WoodPlanks)
        for _, dx in ipairs({-5, 5}) do
            part(model, "AwningPole", Vector3.new(0.6, 9, 0.6), Vector3.new(x + dx, 10.5, -25), {113, 85, 57}, Enum.Material.Wood)
        end
        part(model, "Awning", Vector3.new(12, 0.5, 8), Vector3.new(x, 15, -25), x < 0 and {209, 156, 101} or {93, 174, 167})
    end
    palm(model, -39, -12, 18); palm(model, 41, 4, 20); palm(model, 23, 27, 17); palm(model, -5, 25, 19)
    for i = 0, 4 do
        local tower = part(model, "Lighthouse", Vector3.new(10 - i * 0.6, 5, 10 - i * 0.6), Vector3.new(-32, 9 + i * 5, 17), i % 2 == 0 and {238, 231, 210} or {193, 108, 87})
        tower.Shape = Enum.PartType.Cylinder; tower.CFrame = tower.CFrame * CFrame.Angles(0, 0, math.pi / 2)
        tower.Size = Vector3.new(5, 10 - i * 0.6, 10 - i * 0.6)
    end
    local lamp = part(model, "Beacon", Vector3.new(6, 4, 6), Vector3.new(-32, 34, 17), {255, 224, 152}, Enum.Material.Neon)
    local light = Instance.new("PointLight"); light.Range = 55; light.Brightness = 2; light.Color = lamp.Color; light.Parent = lamp
    part(model, "LighthouseRoof", Vector3.new(10, 1, 10), Vector3.new(-32, 36.5, 17), {55, 76, 83})
    part(model, "FerryGangway", Vector3.new(18, 1, 8), Vector3.new(10, 7, -78), {141, 106, 74}, Enum.Material.WoodPlanks)
    local ferry = part(model, "Ferry", Vector3.new(1, 5, 1), Vector3.new(17, 9, -78), {59, 104, 126})
    label(ferry, "ПЕРЕПРАВА НА РИФ\nСо 2-го уровня", 4)
    prompt(ferry, "Travel", "На коралловый риф", "Переправа · уровень 2")
    part(model, "BoatHull", Vector3.new(9, 2, 17), Vector3.new(24, 1, -78), {90, 67, 52}, Enum.Material.WoodPlanks)
    part(model, "BoatDeck", Vector3.new(7, 0.5, 14), Vector3.new(24, 2.2, -78), {173, 135, 93}, Enum.Material.WoodPlanks)
    part(model, "ReefRock", Vector3.new(47, 12, 38), Vector3.new(reef.X, -1, reef.Z), {96, 142, 144}, Enum.Material.Rock)
    part(model, "ReefSand", Vector3.new(45, 1.5, 36), Vector3.new(reef.X, 5.6, reef.Z), {236, 222, 177}, Enum.Material.Sand)
    part(model, "ReefPier", Vector3.new(18, 1, 35), Vector3.new(reef.X, 7, reef.Z - 27), {137, 104, 80}, Enum.Material.WoodPlanks)
    local returnFerry = part(model, "ReturnFerry", Vector3.new(1, 5, 1), Vector3.new(reef.X + 6, 9, reef.Z - 15), {59, 104, 126})
    label(returnFerry, "ТИХАЯ БУХТА\nОбратно к торговцам", 4)
    prompt(returnFerry, "Travel", "Вернуться в бухту", "Обратная переправа")
    local reefSign = part(model, "ReefSign", Vector3.new(1, 4, 1), Vector3.new(reef.X - 7, 9, reef.Z - 37), {106, 74, 55})
    label(reefSign, "КОРАЛЛОВЫЙ РИФ\nЗдесь водится Страж глубин", 3.5, 300)
    palm(model, reef.X - 11, reef.Z + 10, 14); palm(model, reef.X + 15, reef.Z + 10, 17)
    for i = 1, 10 do
        local a = i * 2.4
        local coral = part(model, "Coral", Vector3.new(2.3, 3 + i % 4, 2.3), Vector3.new(reef.X + math.sin(a) * 29, -1.3, reef.Z - 15 + math.cos(a) * 29), i % 2 == 0 and {207, 115, 136} or {129, 136, 214})
        coral.Shape = Enum.PartType.Ball; coral.CanCollide = false
    end
    -- A short staircase lets swimmers get back onto the main island.
    for i = 0, 7 do
        part(model, "BeachStep", Vector3.new(5, 1, 14), Vector3.new(77 - i * 3, i - 1, 7), {215, 202, 161}, Enum.Material.Sand)
    end
    return refs(model)
end
return World
]]></ProtectedString>
