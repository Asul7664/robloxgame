					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- One shared 480x192 atlas, cropped into 96px icons. Only visible rows are mounted.
-- Existing approved art, native EditableImage or bounded portable gradient fallback.
local AssetService=game:GetService("AssetService")
local Sprite=require(script.Parent:WaitForChild("CatchSprite"))
local Data=require(script.Parent:WaitForChild("ThumbnailArt"))
local ModelView=require(script.Parent:WaitForChild("CreatureViewport"))
local Thumbs={};Thumbs.__index=Thumbs
local function make(cl,props,parent)
    local o=Instance.new(cl);for k,v in pairs(props)do o[k]=v end;o.Parent=parent;return o
end
local function circle(o)make("UICorner",{CornerRadius=UDim.new(1,0)},o)end
local function sample(pixels,index,x,y,res)
    local xx=(index%5)*Data.Cell+math.min(Data.Cell-1,math.floor((x+0.5)*Data.Cell/res))
    local yy=math.floor(index/5)*Data.Cell+math.min(Data.Cell-1,math.floor((y+0.5)*Data.Cell/res))
    local p=(yy*Data.Width+xx)*4
    return Color3.fromRGB(buffer.readu8(pixels,p),buffer.readu8(pixels,p+1),buffer.readu8(pixels,p+2)),
        1-buffer.readu8(pixels,p+3)/255
end
function Thumbs:_load()
    if self.Loading or self.Ready or self.Dead or self.Failed then return end
    self.Loading=true
    task.spawn(function()
        local ok,pixels=pcall(Sprite.Decode,Data)
        if self.Dead then return end
        if not ok then self.Loading=false;self.Failed=true;warn("[QuietCove] Thumbnail decode: "..tostring(pixels));return end
        self.Pixels=pixels
        local image
        local native=pcall(function()
            image=AssetService:CreateEditableImage({Size=Vector2.new(Data.Width,Data.Height)})
            assert(image,"No native thumbnail budget")
            image:WritePixelsBuffer(Vector2.zero,Vector2.new(Data.Width,Data.Height),pixels)
            -- Test Content construction inside the guard as well.
            self.Content=Content.fromObject(image)
        end)
        if self.Dead then if image then image:Destroy()end;return end
        if native then self.Image=image else if image then image:Destroy()end;self.Content=nil end
        self.Ready=true;self.Loading=false
    end)
end
function Thumbs:Add(row,fish,known)
    local c=self.Config.Rarities[fish.Rarity].Color
    local color=Color3.fromRGB(c[1],c[2],c[3])
    local root=make("Frame",{Name="Thumbnail_"..fish.Id,Size=UDim2.fromOffset(78,78),
        Position=UDim2.new(0,10,0.5,-39),BackgroundTransparency=1},row)
    local glow=make("Frame",{Name="RarityDisc",Size=UDim2.fromOffset(72,72),Position=UDim2.fromOffset(3,3),
        BackgroundColor3=color,BackgroundTransparency=known and 0.74 or 0.9,BorderSizePixel=0,ZIndex=1},root);circle(glow)
    make("UIStroke",{Color=color,Transparency=known and 0.42 or 0.78,Thickness=1},glow)
    local canvas=make("Frame",{Name="PortraitCrop",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=2},root)
    if not known then
        make("TextLabel",{Name="UnknownBadge",Text="?",Font=Enum.Font.GothamBold,TextSize=20,
            TextColor3=Color3.fromRGB(203,218,222),Size=UDim2.fromOffset(22,25),Position=UDim2.new(1,-22,1,-25),
            BackgroundTransparency=1,ZIndex=4},root)
    end
    local entry={Row=row,Root=root,Canvas=canvas,Species=fish.Id,Known=known==true,Token=0}
    self.Entries[#self.Entries+1]=entry
    return root
end
function Thumbs:_unmount(e)
    e.Token=e.Token+1;e.Active=false;e.Building=false
    if e.Portrait then e.Portrait:Destroy();e.Portrait=nil end
    if e.ModelView then e.ModelView:Destroy();e.ModelView=nil end
    for _,o in ipairs(e.Canvas:GetChildren())do o:Destroy()end
end
function Thumbs:_mount(e)
    if e.Active or e.Building then return end
    if Sprite.Has(e.Species) and Data.Slots[e.Species]==nil then
        e.Portrait=Sprite.Mount(e.Canvas,e.Species,false,e.Known)
        e.Active=e.Portrait~=nil;e.Root:SetAttribute("ThumbnailReady",e.Portrait and e.Portrait.Ready==true);return
    end
    if e.Species=="verity" or self.Config.ById[e.Species].UseModelPortrait==true then
        e.ModelView=ModelView.Mount(e.Canvas,e.Species,false,e.Known)
        e.Active=e.ModelView~=nil;e.Root:SetAttribute("ThumbnailReady",e.Active);return
    end
    local index=Data.Slots[e.Species]
    if index==nil or not self.Ready then return end
    e.Token=e.Token+1;local token=e.Token;e.Building=true
    local function alive()return not self.Dead and e.Token==token and e.Root.Parent~=nil end
    task.spawn(function()
        if not alive()then return end
        local label
        local ok=false
        if self.Image and self.Content then
            ok=pcall(function()
                label=make("ImageLabel",{Name="FishThumbnail",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,
                    ImageContent=self.Content,ImageRectOffset=Vector2.new((index%5)*Data.Cell,math.floor(index/5)*Data.Cell),
                    ImageRectSize=Vector2.new(Data.Cell,Data.Cell),ScaleType=Enum.ScaleType.Fit,
                    ImageColor3=e.Known and Color3.new(1,1,1) or Color3.fromRGB(37,54,65),ZIndex=2},e.Canvas)
            end)
        end
        if not ok then
            if label then label:Destroy()end
            local res,step=64,16
            local root=make("Frame",{Name="PortableThumbnail",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=2},e.Canvas)
            local count=0
            for x=0,res-1 do
                for y=0,res-1,step do
                    if not alive()then root:Destroy();return end
                    local height=math.min(step,res-y);local colors,alphas={},{};local visible=false
                    for j=0,height-1 do
                        local c,a=sample(self.Pixels,index,x,y+j,res)
                        colors[j+1]=e.Known and c or Color3.fromRGB(37,54,65);alphas[j+1]=a
                        if a<0.995 then visible=true end
                    end
                    if visible then
                        local ck={ColorSequenceKeypoint.new(0,colors[1])}
                        local ak={NumberSequenceKeypoint.new(0,alphas[1])}
                        for j=1,height do
                            ck[#ck+1]=ColorSequenceKeypoint.new((j-0.5)/height,colors[j])
                            ak[#ak+1]=NumberSequenceKeypoint.new((j-0.5)/height,alphas[j])
                        end
                        ck[#ck+1]=ColorSequenceKeypoint.new(1,colors[height]);ak[#ak+1]=NumberSequenceKeypoint.new(1,alphas[height])
                        local strip=make("Frame",{Size=UDim2.fromScale(1/res,height/res),Position=UDim2.fromScale(x/res,y/res),
                            BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=2},root)
                        make("UIGradient",{Rotation=90,Color=ColorSequence.new(ck),Transparency=NumberSequence.new(ak)},strip)
                        count=count+1
                    end
                end
                if x%12==11 then task.wait()end
            end
            root:SetAttribute("StripCount",count)
        end
        if alive()then e.Active=true;e.Building=false;e.Root:SetAttribute("ThumbnailReady",true)end
    end)
end
function Thumbs:Update()
    if self.Dead then return end
    local visible=self.IsVisible()
    if not visible then
        for _,e in ipairs(self.Entries)do if e.Active or e.Building then self:_unmount(e)end end
        return
    end
    self:_load()
    local top=self.Scroll.AbsolutePosition.Y-80
    local bottom=top+self.Scroll.AbsoluteSize.Y+160
    local mounted=0
    for _,e in ipairs(self.Entries)do
        local pos=e.Row.AbsolutePosition.Y;local h=e.Row.AbsoluteSize.Y
        local show=e.Row.Parent~=nil and pos+h>top and pos<bottom and mounted<8
        if show then mounted=mounted+1;self:_mount(e)
            if e.Portrait then e.Root:SetAttribute("ThumbnailReady",e.Portrait.Ready==true)end
        elseif e.Active or e.Building then self:_unmount(e)end
    end
end
function Thumbs:Clear()
    for _,e in ipairs(self.Entries)do self:_unmount(e);e.Root:Destroy()end
    self.Entries={}
end
function Thumbs:Destroy()
    if self.Dead then return end
    self.Dead=true;self:Clear()
    if self.Image then self.Image:Destroy();self.Image=nil end
    self.Pixels=nil;self.Content=nil
end
function Thumbs.new(scroll,config,isVisible)
    return setmetatable({Scroll=scroll,Config=config,IsVisible=isVisible,Entries={},Ready=false,Loading=false},Thumbs)
end
return Thumbs
]]></ProtectedString>
					<string name="ScriptGuid">{7FB7C703-A5A2-4C7D-8BCA-20F8D7B03231}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CatchThumbnails</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc000009aa</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC026_00005">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Local presentation driven ONLY by server-approved cast messages/tool attributes.
-- Smooth visible projectile + curved line, full R6/R15 arm swing, white slash and splash.
-- No remotes are sent here; cosmetics cannot choose catches, money, position or timing.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local Cast=require(RS:WaitForChild("QuietCove"):WaitForChild("CastMath"))
local CastingRig=require(script.Parent:WaitForChild("CastingRig"))
local Effects={};Effects.__index=Effects
local WHITE=Color3.fromRGB(248,255,255)
local AQUA=Color3.fromRGB(148,232,242)
local function make(cl,props,parent)
    local o=Instance.new(cl);for k,v in pairs(props)do o[k]=v end;o.Parent=parent;return o
end
local function part(parent,name,size,color)
    return make("Part",{Name=name,Size=size,Color=color or WHITE,Material=Enum.Material.Neon,
        Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,CastShadow=false},parent)
end
local function anchor(parent,name)
    local p=part(parent,name,Vector3.new(0.1,0.1,0.1));p.Transparency=1;return p
end
local function beam(parent,a,b,width,color,alpha)
    return make("Beam",{Attachment0=a,Attachment1=b,Width0=width,Width1=width,
        Color=ColorSequence.new(color or WHITE),Transparency=NumberSequence.new(alpha or 0),
        FaceCamera=true,LightEmission=0.8,LightInfluence=0,Segments=1},parent)
end
local function rodOf(character)
    if not character then return nil end
    for _,o in ipairs(character:GetChildren())do
        if o:IsA("Tool")and o:GetAttribute("QuietCoveRod")then return o end
    end
end
local function tipOf(tool)
    local handle=tool and tool:FindFirstChild("Handle")
    return handle and handle:FindFirstChild("Tip")
end
function Effects:_removeActor(id)
    local a=self.Actors[id];if not a then return end
    for _,j in ipairs(a.Joints)do if j.Motor.Parent and j.Base then j.Motor.Transform=j.Base end end
    if a.Rig then a.Rig:Destroy() end
    for _,o in ipairs(a.Cosmetics)do o:Destroy()end
    if a.Slash then a.Slash.Root:Destroy()end
    self.Actors[id]=nil
end
function Effects:_actor(player,tool)
    local id=player.UserId;local old=self.Actors[id]
    if old and old.Tool==tool then return old end
    self:_removeActor(id)
    local character=player.Character;local root=character and character:FindFirstChild("HumanoidRootPart")
    local tip=tipOf(tool);if not root or not tip then return nil end
    local rig=CastingRig.new(character,tool,self.Folder);if not rig then return nil end
    local a={Id=id,Tool=tool,Character=character,Root=root,Tip=rig.Tip,BaseGrip=tool.Grip,Joints={},Cosmetics={},Rig=rig}
    tip=rig.Tip
    local handle=rig.Handle
    for i,spec in ipairs({{0.9,0.20},{0.15,0.04}})do
        local p0=make("Attachment",{Name="CastTrailOuter"..i,Position=tip.Position},handle)
        local p1=make("Attachment",{Name="CastTrailInner"..i,Position=tip.Position-Vector3.new(0,spec[1],0)},handle)
        local trail=make("Trail",{Name="WhiteCastSlash"..i,Attachment0=p0,Attachment1=p1,Enabled=false,
            Lifetime=0.20,MinLength=0.025,FaceCamera=true,LightEmission=1,LightInfluence=0,
            Color=ColorSequence.new(WHITE),Transparency=NumberSequence.new({
                NumberSequenceKeypoint.new(0,spec[2]),NumberSequenceKeypoint.new(0.5,0.42),NumberSequenceKeypoint.new(1,1)}),
            WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)})},handle)
        a.Cosmetics[#a.Cosmetics+1]=trail;a.Cosmetics[#a.Cosmetics+1]=p0;a.Cosmetics[#a.Cosmetics+1]=p1
    end
    self.Actors[id]=a;return a
end
function Effects:_scan()
    local localChar=Players.LocalPlayer.Character
    local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
    local seen={}
    for _,p in ipairs(Players:GetPlayers())do
        local tool=rodOf(p.Character);local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if tool and root and (p==Players.LocalPlayer or not localRoot or (root.Position-localRoot.Position).Magnitude<self.Config.Casting.EffectDistance)then
            self:_actor(p,tool);seen[p.UserId]=true
        end
    end
    local gone={};for id in pairs(self.Actors)do if not seen[id]then gone[#gone+1]=id end end
    for _,id in ipairs(gone)do self:_removeActor(id)end
end
function Effects:_state(a,now)
    local stage=a.Tool:GetAttribute("QCFishingStage")or "Idle"
    local at=a.Tool:GetAttribute("QCStageAt")or now
    local power=a.Tool:GetAttribute("QCCastPower")or 0
    if stage=="Charging"then
        at=a.Tool:GetAttribute("QCChargeAt")or at
        power=math.clamp((now-at)/self.Config.ChargeSeconds,0,1)
    elseif stage=="Casting"then at=a.Tool:GetAttribute("QCCastAt")or at end
    if a.Override then
        stage=a.Override.Stage;at=a.Override.At;power=a.Override.Power or power
        if stage=="Charging"then power=math.clamp((now-at)/self.Config.ChargeSeconds,0,1)end
    end
    if a.PosePreview then
        if stage~='Idle' or now>=a.PosePreview.Until then a.PosePreview=nil
        else return a.PosePreview.Stage,now-a.PosePreview.At,a.PosePreview.Power end
    end
    return stage,now-at,power
end

function Effects:PreviewPose(stage,seconds)
    if not RunService:IsStudio()then return false end
    local stages={Idle=true,Charging=true,Casting=true,Waiting=true,Bite=true,Reeling=true,Landing=true}
    assert(stages[stage],"Rod stage: Idle, Charging, Casting, Waiting, Bite, Reeling, Landing")
    assert(type(seconds)=='number' and seconds>=1 and seconds<=20,"Preview duration: 1..20 seconds")
    self:_scan()
    local a=self.Actors[Players.LocalPlayer.UserId]
    assert(a,"Equip a fishing rod and wait for the character to load")
    local now=workspace:GetServerTimeNow()
    a.PosePreview={Stage=stage,At=now,Until=now+seconds,Power=.65}
    return true
end
function Effects:ClearPreviewPoses()
    for _,a in pairs(self.Actors)do a.PosePreview=nil end
end
function Effects:_restoreTransforms()
    for _,a in pairs(self.Actors)do if a.Rig then a.Rig:Restore()end end
end
function Effects:_pose(dt)
    local now=workspace:GetServerTimeNow()
    local gone={}
    for id,a in pairs(self.Actors)do
        if a.Tool.Parent==a.Character and a.Root.Parent then
            local stage,t,power=self:_state(a,now)
            local slash=a.Rig:Step(stage,t,power,self.Config.Casting,dt)
            for _,o in ipairs(a.Cosmetics)do if o:IsA("Trail")then o.Enabled=slash end end
        else gone[#gone+1]=id end
    end
    for _,id in ipairs(gone)do self:_removeActor(id)end
end
function Effects:_splash(position,power)
    local root=anchor(self.Folder,"CastWaterSplash");local rings,drops={},{}
    local base=Vector3.new(position.X,position.Y-0.21,position.Z)
    for ring=1,3 do
        local points,beams={},{};local count=24
        for j=1,count do points[j]=make("Attachment",{Position=base},root)end
        for j=1,count do beams[j]=beam(root,points[j],points[j%count+1],0.12,ring==1 and WHITE or AQUA,0.2)end
        rings[#rings+1]={Points=points,Beams=beams,Delay=(ring-1)*0.13}
    end
    for i=1,16 do
        local a=i*2.39996;local speed=3.4+(i%4)*0.7+power
        local drop=part(root,"SplashDroplet",Vector3.new(0.10,0.16+(i%3)*0.05,0.10),i%2==0 and WHITE or AQUA)
        drop.Shape=Enum.PartType.Ball
        drops[#drops+1]={Part=drop,V=Vector3.new(math.cos(a)*speed,7+(i%5)*1.1+power*2,math.sin(a)*speed)}
    end
    self.Splashes[#self.Splashes+1]={Root=root,Base=base,Rings=rings,Drops=drops,At=workspace:GetServerTimeNow()}
end
function Effects:_updateSplashes(now)
    for i=#self.Splashes,1,-1 do
        local s=self.Splashes[i];local t=now-s.At
        if t>1.65 then s.Root:Destroy();table.remove(self.Splashes,i)
        else
            for _,r in ipairs(s.Rings)do
                local age=t-r.Delay;local u=math.clamp(age/1.3,0,1)
                local radius=0.45+u*5.8
                for j,p in ipairs(r.Points)do
                    local a=2*math.pi*(j-1)/#r.Points
                    p.Position=s.Base+Vector3.new(math.cos(a)*radius,0.025*math.sin(a*3+t*8),math.sin(a)*radius)
                end
                for _,b in ipairs(r.Beams)do
                    b.Transparency=NumberSequence.new(age<0 and 1 or math.min(1,0.20+u*0.80))
                    b.Width0=0.13*(1-u)+0.02;b.Width1=b.Width0
                end
            end
            for _,d in ipairs(s.Drops)do
                local p=s.Base+Vector3.new(0,0.22,0)+d.V*t-Vector3.new(0,21*t*t,0)
                d.Part.Position=p;d.Part.Transparency=p.Y<s.Base.Y and 1 or math.clamp(t/0.75,0,1)
            end
        end
    end
end
function Effects:_end(id)
    local c=self.Casts[id]
    if c then c.Root:Destroy();self.Casts[id]=nil end
end
function Effects:Handle(kind,p)
    if self.Dead then return end
    if kind=="CastEnd" then
        local live=self.Casts[p.UserId]
        if live and live.Data.Id~=p.Id then return end -- stale end must not stop a newer swing
        if live then self:_end(p.UserId)end
        local a=self.Actors[p.UserId]
        if a then
            if a.Id==Players.LocalPlayer.UserId then a.Override={Stage="Idle",At=workspace:GetServerTimeNow()} end
            if a.Slash then a.Slash.Root:Destroy();a.Slash=nil end
        end
        return
    end
    if kind=="Stage"then
        self:_scan()
        local a=self.Actors[Players.LocalPlayer.UserId]
        if a then a.Override={Stage=p.Stage,At=p.Started or workspace:GetServerTimeNow(),Power=p.Power}end
        return
    end
    if kind~="CastVisual"then return end
    local player=Players:GetPlayerByUserId(p.UserId)
    if not player or not p.Tool or p.Tool.Parent~=player.Character then return end
    local existing=self.Casts[p.UserId]
    if existing and existing.Data.Id==p.Id then return end -- Ready replay is idempotent.
    local localChar=Players.LocalPlayer.Character
    local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
    if localRoot and (localRoot.Position-p.Target).Magnitude>self.Config.Casting.EffectDistance then return end
    local a=self:_actor(player,p.Tool);if not a then return end
    self:_end(p.UserId)
    local root=anchor(self.Folder,"VisibleCast_"..p.UserId)
    local bobber=part(root,"VisibleBobber",Vector3.new(0.40,0.6,0.40),Color3.fromRGB(250,164,101));bobber.Shape=Enum.PartType.Ball
    local cap=part(root,"BobberWhiteCap",Vector3.new(0.29,0.20,0.29),WHITE);cap.Shape=Enum.PartType.Ball
    local points,beams={},{}
    for i=1,10 do points[i]=make("Attachment",{},root)end
    for i=1,9 do beams[i]=beam(root,points[i],points[i+1],0.048,WHITE,0.13)end
    local tail0=make("Attachment",{Position=Vector3.new(-0.07,0,0)},bobber)
    local tail1=make("Attachment",{Position=Vector3.new(0.07,0,0)},bobber)
    local trail=make("Trail",{Name="FlyingLineGlint",Attachment0=tail0,Attachment1=tail1,Lifetime=0.20,
        MinLength=0.03,FaceCamera=true,LightEmission=1,Color=ColorSequence.new(WHITE),
        Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)})},bobber)
    local elapsed=workspace:GetServerTimeNow()-p.Started
    local late=elapsed>p.Swing+p.Flight+0.2
    self.Casts[p.UserId]={Root=root,Bobber=bobber,Cap=cap,Trail=trail,Points=points,Beams=beams,Data=p,Tip=a.Tip,Impact=late}
    -- White Trails use actual rod-tip motion; no unrelated fixed crescent.
end
function Effects:_render()
    if self.Dead then return end
    local now=workspace:GetServerTimeNow()
    if now>=self.ScanAt then self.ScanAt=now+0.20;self:_scan()end
    for id,c in pairs(self.Casts)do
        local p=c.Data
        local actor=self.Actors[id]
        local currentTip=c.Tip
        -- The native Tool moves during simulation, after the IK step. Read its
        -- current tip at render time while walking or using standard carry.
        if actor and actor.Rig and not actor.Rig.LastRod then currentTip=tipOf(p.Tool)end
        if not p.Tool.Parent or not currentTip or not currentTip.Parent or (p.Marker and not p.Marker.Parent)then self:_end(id)
        else
            local elapsed=now-p.Started;local t=Cast.Progress(now,p.Started,p.Swing,p.Flight)
            local tip=currentTip.WorldPosition
            local position
            if elapsed<p.Swing then
                position=tip;c.PreviousTip=tip;c.PreviousTipAt=now
            elseif t<1 then
                if not c.LaunchOrigin then
                    c.LaunchOrigin=p.Origin;c.VisualVelocity=p.LaunchVelocity
                    -- Interpolate the actual grip-adjusted tip at the release instant.
                    -- Starting at the first AFTER-release frame would add an extra-frame jump.
                    local span=c.PreviousTipAt and now-c.PreviousTipAt
                    if c.PreviousTip and span and span>0 and span<.15 and t<.16 then
                        local alpha=math.clamp((p.Started+p.Swing-c.PreviousTipAt)/span,0,1)
                        local v=(tip-c.PreviousTip)/span
                        if v.Magnitude<160 then
                            c.LaunchOrigin=c.PreviousTip+(tip-c.PreviousTip)*alpha
                            if v.Magnitude>.1 then c.VisualVelocity=v end
                        end
                    end
                end
                position=Cast.Position(c.LaunchOrigin,p.Target,t,p.Arc,p.LaunchDirection,c.VisualVelocity,p.Flight)
            else
                if not c.Impact then c.Impact=true;self:_splash(p.Target,p.Power)end
                local stage=p.Tool:GetAttribute("QCFishingStage")
                local rate=stage=="Bite" and 18 or 3
                position=p.Target+Vector3.new(0,math.sin(now*rate)*0.10,0)
            end
            c.Bobber.Position=position;c.Cap.Position=position+Vector3.new(0,0.22,0)
            c.Trail.Enabled=elapsed>=p.Swing and t<1
            local sag=t<1 and math.sin(math.pi*t)*2.6 or 0.5
            for i,a in ipairs(c.Points)do
                local u=(i-1)/(#c.Points-1)
                a.Position=tip+(position-tip)*u-Vector3.new(0,math.sin(math.pi*u)*sag,0)
            end
        end
    end
    self:_updateSplashes(now)
end
function Effects:Destroy()
    if self.Dead then return end;self.Dead=true
    self.Pre:Disconnect();self.Sim:Disconnect();self.Render:Disconnect()
    local ids={};for id in pairs(self.Actors)do ids[#ids+1]=id end
    for _,id in ipairs(ids)do self:_removeActor(id)end
    self.Casts={};self.Splashes={};self.Folder:Destroy()
end
function Effects.new(config)
    local self=setmetatable({Config=config,Actors={},Casts={},Splashes={},ScanAt=0},Effects)
    self.Folder=make("Folder",{Name="QuietCoveLocalCastEffects"},workspace)
    self.Pre=RunService.PreAnimation:Connect(function()self:_restoreTransforms()end)
    self.Sim=RunService.PreSimulation:Connect(function(dt)self:_pose(math.min(dt,0.1))end)
    self.Render=RunService.RenderStepped:Connect(function()self:_render()end)
    return self
end
return Effects
]]></ProtectedString>
					<string name="ScriptGuid">{A9B5C2D4-40C2-450F-91F5-980BE54CED64}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CastEffects</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc000009ab</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC027_000005">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Analytic two-bone IK after Animator, not approximate independent arm angles.
-- Both hand grip points are solved against ONE visible rod transform. R15 has elbows/knees;
-- R6 is a single-segment fallback (its rig physically has no elbow/knee joints).
-- Supports both Motor6D and upgraded R15 AnimationConstraint joints. Never edits rig attachments.
local RS=game:GetService('ReplicatedStorage')
local Models=require(RS:WaitForChild('QuietCove'):WaitForChild('EquipmentModels'))
local Cast=require(RS:WaitForChild('QuietCove'):WaitForChild('CastMath'))
local Clearance=require(RS:WaitForChild('QuietCove'):WaitForChild('RodClearance'))
local Rig={};Rig.__index=Rig
local function clamp(x,a,b)return math.max(a,math.min(b,x))end
local function rot(cf)return CFrame.new(cf.Position):Inverse()*cf end
local function deg(x,y,z)return CFrame.Angles(math.rad(x or 0),math.rad(y or 0),math.rad(z or 0))end
local function basis(axis,ref)
    axis=axis.Unit
    local x=axis:Cross(ref)
    if x.Magnitude<.001 then x=axis:Cross(Vector3.new(1,0,0))end
    if x.Magnitude<.001 then x=axis:Cross(Vector3.new(0,1,0))end
    x=x.Unit;return CFrame.fromMatrix(Vector3.new(),x,axis,x:Cross(axis).Unit)
end
local function segment(localA,localB,worldA,worldB,normal)
    local r=basis(worldB-worldA,normal)*basis(localB-localA,Vector3.new(0,0,1)):Inverse()
    return CFrame.new(worldA)*r*CFrame.new(-localA)
end
local function animationJoint(j)
    local a,b=j.Attachment0,j.Attachment1
    if not a or not b or not a.Parent or not b.Parent
        or not a.Parent:IsA('BasePart')or not b.Parent:IsA('BasePart')or j.Enabled==false then return nil end
    -- Read attachments directly instead of deprecated C0/C1 compatibility aliases.
    return setmetatable({Source=j,IsConstraint=true},{
        __index=function(_,key)
            if key=='Part0'then return a.Parent elseif key=='Part1'then return b.Parent
            elseif key=='C0'then return a.CFrame elseif key=='C1'then return b.CFrame end
            return j[key]
        end,
        __newindex=function(_,key,value)
            if key=='Transform'then j.Transform=value else error('Joint adapter writes only Transform')end
        end,
    })
end
local function jointName(part,fallback)
    local names={LowerTorso='Root',UpperTorso='Waist',Head='Neck',Torso='RootJoint'}
    if names[part.Name]then return names[part.Name]end
    for _,side in ipairs({'Right','Left'})do
        local types={UpperArm='Shoulder',LowerArm='Elbow',Hand='Wrist',UpperLeg='Hip',LowerLeg='Knee',Foot='Ankle'}
        for body,joint in pairs(types)do if part.Name==side..body then return side..joint end end
    end
    return fallback
end
function Rig.new(character,tool,parent)
    local root=character:FindFirstChild('HumanoidRootPart');if not root then return nil end
    local self=setmetatable({Character=character,Root=root,Tool=tool,ByPart={},Joints={},OriginalParts={},Saved={},Weight=0,Cache={},ConstraintStates={},KinematicsActive=false},Rig)
    -- Two passes make upgraded constraints win when a compatibility Motor6D also exists.
    for _,j in ipairs(character:GetDescendants())do
        if j:IsA('Motor6D')and j.Part0 and j.Part1 then
            self.ByPart[j.Part1]=j;self.Joints[jointName(j.Part1,j.Name)]=j
        end
    end
    for _,j in ipairs(character:GetDescendants())do
        if j:IsA('AnimationConstraint')then
            local view=animationJoint(j)
            if view then
                self.ByPart[view.Part1]=view;self.Joints[jointName(view.Part1,j.Name)]=view
                self.ConstraintStates[#self.ConstraintStates+1]={Joint=j,Original=j.IsKinematic}
            end
        end
    end
    for _,p in ipairs(tool:GetDescendants())do
        if p:IsA('BasePart')then self.OriginalParts[#self.OriginalParts+1]={Part=p,Alpha=p.LocalTransparencyModifier}end
    end
    local wrap=Instance.new('Model');wrap.Name='TwoHandRod';wrap.Parent=parent
    local clone=Models.Rod(tool:GetAttribute('RodStyle')or 'wood',true);clone.Parent=wrap
    local h=clone:FindFirstChild('Handle');wrap.PrimaryPart=h
    self.Visual=wrap;self.Handle=h;self.Tip=h:FindFirstChild('Tip');self.Clone=clone;self.VisibleParts={}
    for _,p in ipairs(clone:GetDescendants())do if p:IsA('BasePart')then
        self.VisibleParts[#self.VisibleParts+1]=p;p.LocalTransparencyModifier=1
    end end
    self.R15=character:FindFirstChild('RightUpperArm')~=nil
    self.RodShapes=Clearance.Describe(clone,h)
    self.BodyParts=Clearance.BodyParts(character)
    return self
end
function Rig:_kinematic(active)
    if active==self.KinematicsActive then return end
    self.KinematicsActive=active
    for _,entry in ipairs(self.ConstraintStates)do
        if entry.Joint.Parent then
            if active then entry.Original=entry.Joint.IsKinematic;entry.Joint.IsKinematic=true
            else entry.Joint.IsKinematic=entry.Original end
        end
    end
end
function Rig:Restore()
    for j,v in pairs(self.Saved)do if j.Parent then j.Transform=v end end
    self.Saved={};self.Cache={}
end
function Rig:_world(part)
    if part==self.Root then return self.Root.CFrame end
    if self.Cache[part]then return self.Cache[part]end
    local j=self.ByPart[part]
    local cf=j and self:_world(j.Part0)*j.C0*j.Transform*j.C1:Inverse()or part.CFrame
    self.Cache[part]=cf;return cf
end
function Rig:_set(j,transform,weight)
    if not j then return end
    if not self.Saved[j]then self.Saved[j]=j.Transform end
    j.Transform=self.Saved[j]:Lerp(transform,weight or self.Weight)
    self.Cache={}
end
function Rig:_place(j,cf,weight)
    if not j then return end
    local t=j.C0:Inverse()*self:_world(j.Part0):Inverse()*cf*j.C1
    -- The main hand follows the already blended rod exactly throughout entry.
    self:_set(j,t,weight)
end
function Rig:_limb(shoulder,elbow,wrist,handCF,pole,weight)
    if not shoulder or not elbow or not wrist then return end
    local S=(self:_world(shoulder.Part0)*shoulder.C0).Position
    local target=(handCF*wrist.C1).Position
    local a=(elbow.C0.Position-shoulder.C1.Position).Magnitude
    local b=(wrist.C0.Position-elbow.C1.Position).Magnitude
    if a<.01 or b<.01 then return end
    local delta=target-S;local dist=delta.Magnitude;if dist<.001 then return end
    local d=clamp(dist,math.abs(a-b)+.002,a+b-.002)
    local axis=delta.Unit;local T=S+axis*d
    local bend=pole-S-axis*(pole-S):Dot(axis)
    if bend.Magnitude<.001 then bend=self.Root.CFrame.LookVector-axis*self.Root.CFrame.LookVector:Dot(axis)end
    if bend.Magnitude<.001 then bend=Vector3.new(0,1,0):Cross(axis)end
    bend=bend.Unit
    local along=(a*a-b*b+d*d)/(2*d)
    local height=math.sqrt(math.max(0,a*a-along*along))
    local E=S+axis*along+bend*height
    local normal=axis:Cross(bend).Unit
    local upper=segment(shoulder.C1.Position,elbow.C0.Position,S,E,normal)
    local lower=segment(elbow.C1.Position,wrist.C0.Position,E,T,normal)
    local palm=CFrame.new(T)*rot(handCF)*CFrame.new(-wrist.C1.Position)
    self:_place(shoulder,upper,weight);self:_place(elbow,lower,weight);self:_place(wrist,palm,weight)
end
function Rig:_grasp(side,rodCF)
    local name=side=='Right' and 'CastMainGrip' or 'CastSupportGrip'
    local target=self.Handle and self.Handle:FindFirstChild(name)
    local fallback=CFrame.new(0,side=='Right' and -0.25 or 0.25,0)*deg(0,0,side=='Right' and -65 or 65)
    -- Actual rod attachments are the single source of truth for BOTH hands.
    return rodCF*(target and target.CFrame or fallback)
end
function Rig:_grip(side,rodCF)
    local hand=self.Character:FindFirstChild(side..'Hand')
    local attach=hand and hand:FindFirstChild(side..'GripAttachment')
    local localGrip=attach and attach.CFrame or CFrame.new(0,-.18,0)
    return self:_grasp(side,rodCF)*localGrip:Inverse()
end
function Rig:_fitRod(rodCF)
    -- Reach-aware translation; no stretching bones on scaled avatars.
    if not self.R15 then
        -- R6 has no elbow: fit both rigid arm endpoints to their rod grips.
        -- The handle centre lies on the intersection of two reach spheres.
        local centres,lengths={},{}
        for _,side in ipairs({'Right','Left'})do
            local j=self.Joints[side..' Shoulder']
            if not j then return rodCF end
            local S=(self:_world(j.Part0)*j.C0).Position
            local localEnd=Vector3.new(0,-j.Part1.Size.Y*.46,0)
            lengths[#lengths+1]=(localEnd-j.C1.Position).Magnitude
            centres[#centres+1]=S-(self:_grasp(side,rodCF).Position-rodCF.Position)
        end
        local delta=centres[2]-centres[1];local d=delta.Magnitude
        if d>.001 and d<lengths[1]+lengths[2] and d>math.abs(lengths[1]-lengths[2])then
            local axis=delta.Unit
            local along=(lengths[1]^2-lengths[2]^2+d*d)/(2*d)
            local radius=math.sqrt(math.max(0,lengths[1]^2-along*along))
            local centre=centres[1]+axis*along
            local projected=rodCF.Position-centre
            projected=projected-axis*projected:Dot(axis)
            if projected.Magnitude<.001 then projected=self.Root.CFrame.LookVector end
            return CFrame.new(centre+projected.Unit*radius)*rot(rodCF)
        end
        return rodCF
    end
    for _=1,3 do
        for _,side in ipairs({'Left','Right'})do
            local a,b,c=self.Joints[side..'Shoulder'],self.Joints[side..'Elbow'],self.Joints[side..'Wrist']
            if a and b and c then
                local S=(self:_world(a.Part0)*a.C0).Position
                local T=(self:_grip(side,rodCF)*c.C1).Position
                local reach=(b.C0.Position-a.C1.Position).Magnitude+(c.C0.Position-b.C1.Position).Magnitude-.025
                local delta=T-S
                if delta.Magnitude>reach then
                    local correction=-delta.Unit*(delta.Magnitude-reach)
                    rodCF=CFrame.new(correction)*rodCF
                end
            end
        end
    end
    return rodCF
end

function Rig:_safeRod(desired,finalPose)
    local function safe(candidate)
        candidate=self:_fitRod(candidate)
        if Clearance.Check(candidate,self.RodShapes,self.BodyParts,function(part)return self:_world(part)end,.06)then
            return candidate
        end
    end
    local fitted=safe(desired)
    if fitted then return fitted end
    if finalPose then
        fitted=safe(finalPose)
        if fitted then return fitted end
        desired=finalPose
    end
    -- Clearance is evaluated AFTER reach fitting, including the reel and butt.
    local root=self.Root.CFrame
    local localFrame=root:ToObjectSpace(desired)
    for _,pitch in ipairs({8,16,-8})do
        for _,offset in ipairs({Vector3.new(0,0,-.15),Vector3.new(.22,0,-.15),
            Vector3.new(-.22,0,-.15),Vector3.new(0,.16,-.12),Vector3.new(0,-.16,-.12)})do
            fitted=safe(root*CFrame.new(offset)*localFrame*deg(pitch,0,0))
            if fitted then return fitted end
        end
    end
    return nil
end

function Rig:_deactivate()
    self:Restore();self:_kinematic(false);self.Weight=0
    self.FootTargets=nil;self.LastFrame=nil;self.LastRod=nil;self.PreviousStage=nil;self.Transition=nil
    for _,o in ipairs(self.OriginalParts)do if o.Part.Parent then o.Part.LocalTransparencyModifier=o.Alpha end end
    for _,part in ipairs(self.VisibleParts)do if part.Parent then part.LocalTransparencyModifier=1 end end
    -- Invisible clone tip follows the native Tool when fishing while moving.
    local actual=self.Tool:FindFirstChild('Handle')
    if actual then self.Visual:PivotTo(actual.CFrame)end
end
function Rig:Step(stage,t,power,config,dt)
    local humanoid=self.Character:FindFirstChildOfClass('Humanoid')
    local velocity=self.Root.AssemblyLinearVelocity or Vector3.zero
    local moving=humanoid and (humanoid.MoveDirection.Magnitude>.05
        or Vector3.new(velocity.X,0,velocity.Z).Magnitude>1)
    local fishing={Charging=true,Casting=true,Waiting=true,Bite=true,Reeling=true,Landing=true}
    local active=self.Tool.Parent==self.Character and fishing[stage]==true and humanoid
        and humanoid.Health>0 and not humanoid.Sit and not moving
    if not active then self:_deactivate();return false end
    local alpha=1-math.exp(-7*dt)
    self.Weight=self.Weight+((active and 1 or 0)-self.Weight)*alpha
    local shown=self.Weight>.008
    self:_kinematic(shown)
    for _,o in ipairs(self.OriginalParts)do if o.Part.Parent then o.Part.LocalTransparencyModifier=shown and 1 or o.Alpha end end
    for _,p in ipairs(self.VisibleParts)do if p.Parent then p.LocalTransparencyModifier=shown and 0 or 1 end end
    if not shown then self.FootTargets=nil;self.LastFrame=nil;self.PreviousStage=nil;self.Transition=nil;return false end
    self.Cache={}
    local f=Cast.Frame(stage,t,power,config)
    if active and stage~=self.PreviousStage and self.LastFrame and stage~='Charging' and stage~='Casting' then
        self.Transition={From=self.LastFrame,Age=0}
    end
    if self.Transition then
        self.Transition.Age=self.Transition.Age+dt
        local u=Cast.Smooth(self.Transition.Age/.30)
        for k,v in pairs(f)do if type(v)=='number' and self.Transition.From[k]then f[k]=self.Transition.From[k]+(v-self.Transition.From[k])*u end end
        if u>=1 then self.Transition=nil end
    end
    self.PreviousStage=stage
    if not active and self.LastFrame then f=self.LastFrame else self.LastFrame=f end
    local root=self.Root.CFrame
    local rigRoot=self.Joints.Root or self.Joints.RootJoint
    local waist=self.Joints.Waist
    local neck=self.Joints.Neck
    local plant=(stage=='Charging' or stage=='Casting') and humanoid and not humanoid.Sit and humanoid.MoveDirection.Magnitude<.05
    if not plant then self.FootTargets=nil end
    if plant and not self.FootTargets then
        self.FootTargets={}
        for _,side in ipairs({'Left','Right'})do local foot=self.Character:FindFirstChild(side..'Foot')
            if foot then self.FootTargets[side]=root:Inverse()*self:_world(foot) end
        end
    end
    if rigRoot then self:_set(rigRoot,CFrame.new(f.ShiftX,-f.Drop,f.ShiftZ)*deg(f.Lean*(waist and .22 or 1),f.Twist*(waist and .24 or 1),0))end
    if waist then self:_set(waist,deg(f.Lean*.78,f.Twist*.76,0))end
    if neck then self:_set(neck,deg(-f.Lean*.5,-f.Twist*.48,0))end
    local finalPose=root*Cast.RodFrame(f)
    local desired=finalPose
    local actual=self.Tool:FindFirstChild('Handle')
    if self.Weight<.999 and actual then desired=actual.CFrame:Lerp(finalPose,self.Weight)end
    local rodCF=self:_safeRod(desired,finalPose)
    if not rodCF then self:_deactivate();return false end
    if self.R15 then
        for _,side in ipairs({'Right','Left'})do
            local sign=side=='Right' and 1 or -1
            -- Roblox forward is -Z.  Keep elbows in front of the torso instead of folding them into the chest.
            local rightHint,leftHint
            if stage=='Charging' then
                rightHint=Vector3.new(1.38,-0.18,-0.12)
                leftHint=Vector3.new(-1.02,-0.50,-0.30)
            elseif stage=='Casting' then
                rightHint=Vector3.new(1.48,-0.24,-0.72)
                leftHint=Vector3.new(-1.08,-0.56,-0.92)
            else
                rightHint=Vector3.new(1.10,-0.55,-0.55)
                leftHint=Vector3.new(-1.10,-0.55,-0.55)
            end
            local elbowHint=root*(side=='Right' and rightHint or leftHint)
            self:_limb(self.Joints[side..'Shoulder'],self.Joints[side..'Elbow'],self.Joints[side..'Wrist'],
                self:_grip(side,rodCF),elbowHint,side=='Right' and 1 or nil)
            local planted=self.FootTargets and self.FootTargets[side]
            if planted then
                self:_limb(self.Joints[side..'Hip'],self.Joints[side..'Knee'],self.Joints[side..'Ankle'],
                    root*planted,root*Vector3.new(sign*.70,-1.0,-2.5))
            end
        end
    else
        -- R6 rigid arms point from their shoulders toward the two grip positions.
        for _,side in ipairs({'Right','Left'})do
            local j=self.Joints[side..' Shoulder']
            if j then
                local S=(self:_world(j.Part0)*j.C0).Position
                local target=self:_grasp(side,rodCF).Position
                local localEnd=Vector3.new(0,-j.Part1.Size.Y*.46,0)
                local length=(localEnd-j.C1.Position).Magnitude
                local endPoint=S+(target-S).Unit*length
                -- The R6 shoulder is on the upper inner corner of the block.
                -- Keep that corner above the arm centre, rather than rolling
                -- both blocks upward and crossing them high over the chest.
                self:_place(j,segment(j.C1.Position,localEnd,S,endPoint,-root.LookVector),side=='Right' and 1 or nil)
            end
        end
    end
    -- Never interpolate again here: that could reintroduce a body intersection.
    self.Visual:PivotTo(rodCF)
    self.LastRod=rodCF
    return f.Slash
end
function Rig:Destroy()
    self:Restore();self:_kinematic(false)
    for _,o in ipairs(self.OriginalParts)do if o.Part.Parent then o.Part.LocalTransparencyModifier=o.Alpha end end
    if self.Visual then self.Visual:Destroy()end
end
return Rig
]]></ProtectedString>
