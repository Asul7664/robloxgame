					<ProtectedString name="Source"><![CDATA[-- Extends, never replaces, the original island and reef. Built once, also exported
-- into the place by the geometry-only build tool so islands are editable in Studio.
local Workspace=game:GetService("Workspace")
local Config=require(game:GetService("ReplicatedStorage"):WaitForChild("QuietCove"):WaitForChild("Config"))
local A={}
local function part(parent,name,x,y,z,sx,sy,sz,color,material,class)
    local p=Instance.new(class or "Part");p.Name=name;p.Size=Vector3.new(sx,sy,sz);p.CFrame=CFrame.new(x,y,z)
    p.Color=Color3.fromRGB(color[1],color[2],color[3]);p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function label(parent,caption,height,width)
    local g=Instance.new("BillboardGui");g.Name="Label";g.Size=UDim2.fromOffset(width or 290,64)
    g.StudsOffset=Vector3.new(0,height or 5,0);g.AlwaysOnTop=false;g.MaxDistance=130;g.Parent=parent
    local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1
    t.Text=caption;t.TextColor3=Color3.fromRGB(247,246,233);t.TextStrokeTransparency=0.25
    t.Font=Enum.Font.GothamBold;t.TextSize=16;t.TextWrapped=true;t.Parent=g
end
local function prompt(parent,name,text,object)
    local p=Instance.new("ProximityPrompt");p.Name=name;p.ActionText=text;p.ObjectText=object
    p.KeyboardKeyCode=Enum.KeyCode.E;p.HoldDuration=0.2;p.MaxActivationDistance=12
    p.RequiresLineOfSight=false;p.Parent=parent;return p
end
local function tree(parent,x,z,h,color,palm)
    local trunk=part(parent,"TreeTrunk",x,6+h/2,z,2.8,h,2.8,{111,80,49},Enum.Material.Wood)
    if palm then
        for i=0,5 do
            local a=i*math.pi/3
            local l=part(parent,"PalmLeaf",x+math.sin(a)*4,6+h,z+math.cos(a)*4,4,0.6,15,color,Enum.Material.Grass)
            l.CFrame=l.CFrame*CFrame.Angles(0,a,0.12);l.CanCollide=false
        end
    else
        for i=0,2 do
            local c=part(parent,"LeafCanopy",x+(i-1)*3,6+h-i*2,z,18-i*3,11,15,color,Enum.Material.Grass)
            c.Shape=Enum.PartType.Ball;c.CanCollide=false
        end
        for _,side in ipairs({-1,1})do
            local branch=part(parent,"Branch",x+side*4,6+h*0.63,z,2.2,h*0.5,2.2,{111,80,49},Enum.Material.Wood)
            branch.CFrame=branch.CFrame*CFrame.Angles(0,0,side*0.65);branch.CanCollide=false
        end
    end
end
local function cylinder(parent,name,x,y,z,height,diameter,color,material)
    local p=part(parent,name,x,y,z,height,diameter,diameter,color,material)
    p.Shape=Enum.PartType.Cylinder;p.CFrame=p.CFrame*CFrame.Angles(0,0,math.pi/2);return p
end
local function npc(parent,name,x,z,shirt,title,action)
    local model=Instance.new("Model");model.Name=name;model.Parent=parent
    local body=part(model,"Body",x,9.3,z,2.5,2.8,1.4,shirt)
    part(model,"Head",x,11.5,z,1.7,1.7,1.7,{224,181,139})
    part(model,"Hat",x,12.4,z,2.6,0.3,2.2,{236,233,209})
    part(model,"HatBand",x,12.5,z,1.8,0.35,1.5,shirt)
    for _,side in ipairs({-1,1})do
        part(model,"Arm",x+side*1.6,9.3,z,0.6,2.5,1,shirt)
        part(model,"Leg",x+side*0.65,7.2,z,0.9,1.6,1.2,{47,57,68})
        part(model,"Eye",x+side*0.36,11.65,z-0.88,0.17,0.17,0.1,{24,30,35})
    end
    label(body,title,5.1);prompt(body,name.."Prompt",action,title)
    return body
end
local function dock(folder,d)
    local x,z=d.DockX,d.DockZ
    local m=Instance.new("Model");m.Name="Dock_"..d.Id;m.Parent=folder
    -- 34-stud pier joins the island shore; wide end leaves the captain unobstructed.
    part(m,"Boardwalk",x,7,z-9,12,1,36,{142,106,72},Enum.Material.WoodPlanks)
    part(m,"Jetty",x,7,z+6,30,1,14,{164,122,78},Enum.Material.WoodPlanks)
    for _,dx in ipairs({-13,13})do
        part(m,"Pile",x+dx,1,z+9,1.3,15,1.3,{99,77,53},Enum.Material.Wood)
        part(m,"Bollard",x+dx,8.2,z+9,1.5,1.4,1.5,{68,78,83},Enum.Material.Metal)
    end
    local cap=npc(m,"Captain",x-7,z+2,{49,99,124},d.Id=="Cove" and "КАПИТАН МИРОН · ЛОДКИ" or "ПРИЧАЛ · ВЫЗОВ ЛОДКИ","Лодки / вызвать")
    local shop=part(m,"Canopy",x-7,15,z+2,11,0.4,8,d.Color)
    for _,dx in ipairs({-12,-2})do part(m,"ShopPole",x+dx,10.7,z+3,0.5,8.3,0.5,{105,85,58},Enum.Material.Wood)end
    local s=part(m,"DockSign",x+8,9,z+1,0.6,3,0.6,{123,98,61},Enum.Material.Wood)
    label(s,d.Name.."\nM — карта · E у капитана",5,320)
    -- Steps make manual swimming access possible even with a low dock approach.
    for i=0,5 do part(m,"WaterStep",x+12,0.25+i*1.2,z+23-i*2.4,7,1.2,3,{150,112,76},Enum.Material.WoodPlanks)end
    if d.Id~="Cove" and d.Id~="Reef" then
        npc(m,"Buyer",x+7,z-13,{186,131,70},"СКУПЩИК · ПРОДАЖА УЛОВА","Продать весь улов")
    end
end
local function island(folder,d)
    local m=Instance.new("Model");m.Name=d.Id;m.Parent=folder
    local sand=d.Theme=="sand";local moss=d.Theme=="moss";local storm=d.Theme=="storm"
    local ground=sand and {223,181,109} or (storm and {90,105,122} or {122,156,102})
    cylinder(m,"IslandStone",d.X,-2,d.Z,15,d.Radius*2+8,storm and {54,67,83} or {126,126,107},Enum.Material.Rock)
    cylinder(m,"Shore",d.X,5,d.Z,2.6,d.Radius*2,{228,207,163},Enum.Material.Sand)
    cylinder(m,"Plateau",d.X,6.5,d.Z,1.5,d.Radius*1.78,ground,sand and Enum.Material.Sand or (storm and Enum.Material.Slate or Enum.Material.Grass))
    part(m,"IslandPath",d.X,7.3,d.Z,10,0.2,d.Radius*2+10,{204,183,142},Enum.Material.Sand)
    part(m,"FishingPier",d.X,7,d.Z-d.Radius-12,14,1,32,{151,114,78},Enum.Material.WoodPlanks)
    part(m,"FishingDeck",d.X,7,d.Z-d.Radius-28,27,1,14,{164,124,86},Enum.Material.WoodPlanks)
    local marker=part(m,"FishingMarker",d.X-10,9,d.Z-d.Radius-27,0.7,4,0.7,{102,78,46},Enum.Material.Wood)
    label(marker,"РЫБАЛКА · УРОВЕНЬ "..d.Level.."\n"..d.Target,4.5,350)
    local beacon=part(m,"IslandBeacon",d.X,9,d.Z+18,4,0.3,4,d.Color,Enum.Material.Neon);beacon.CanCollide=false
    label(beacon,d.Name.."\nУровень "..d.Level,18,320)
    for i=1,8 do
        local a=i*2.37;local r=d.Radius*0.64
        local x,z=d.X+math.sin(a)*r,d.Z+math.cos(a)*r
        if math.abs(x-d.X)>12 then
            if not storm then tree(m,x,z,sand and 15 or 20+i%3*3,
                sand and {82,139,92} or (moss and {64,130,73} or {232,155,185}),sand)
            else
                local stone=part(m,"BasaltSpire",x,10+i,z,7+i%3,18+i*2,8,{65+i*3,78+i*3,98+i*3},Enum.Material.Slate,"WedgePart")
                stone.CFrame=stone.CFrame*CFrame.Angles(0,a,0)
            end
        end
    end
    if sand then
        -- Sandstone temple, obelisks, and oasis; no paid/external meshes.
        for i=0,4 do part(m,"TempleTier",d.X+27,8+i*3,d.Z-5,29-i*4,3,29-i*4,{204+i*6,162+i*6,95+i*6},Enum.Material.Sandstone)end
        for _,z in ipairs({-21,18})do
            local ob=part(m,"Obelisk",d.X-23,15,d.Z+z,3.5,16,3.5,{233,187,107},Enum.Material.Sandstone)
            part(m,"SunCap",d.X-23,24,d.Z+z,4,3,4,{255,205,85},Enum.Material.Neon,"WedgePart")
        end
        local oasis=cylinder(m,"Oasis",d.X-30,7.5,d.Z-4,0.18,20,{64,183,193},Enum.Material.Glass);oasis.CanCollide=false
    elseif moss then
        for i=1,11 do
            local a=i*2.1;local x,z=d.X+math.sin(a)*28,d.Z+math.cos(a)*31
            if math.abs(x-d.X)>7 then
                part(m,"MushroomStem",x,8.5,z,0.7,3,0.7,{208,198,151})
                local sh=part(m,"MushroomCap",x,10.1,z,3.7,1.2,3.7,{99,207,145},Enum.Material.Neon);sh.Shape=Enum.PartType.Ball;sh.CanCollide=false
            end
        end
        part(m,"GroveArchTop",d.X+24,18,d.Z-8,22,4,5,{95,112,87},Enum.Material.Rock)
        for _,dx in ipairs({15,33})do part(m,"GroveArch",d.X+dx,12,d.Z-8,4,14,5,{95,112,87},Enum.Material.Rock)end
    elseif d.Theme=="bloom" then
        cylinder(m,"CupPlinth",d.X+24,9,d.Z,4,23,{224,188,147},Enum.Material.Marble)
        cylinder(m,"CappuccinoCup",d.X+24,16,d.Z,12,17,{245,225,184},Enum.Material.Marble)
        cylinder(m,"CoffeeSurface",d.X+24,22.1,d.Z,0.3,15,{136,83,39})
        cylinder(m,"LatteFoam",d.X+24,22.3,d.Z,0.25,9,{239,208,150})
        part(m,"CupHandleTop",d.X+35,20,d.Z,7,2.2,2.2,{245,225,184})
        part(m,"CupHandleSide",d.X+38,16,d.Z,2.2,8,2.2,{245,225,184})
        part(m,"CupHandleBottom",d.X+35,12,d.Z,7,2.2,2.2,{245,225,184})
    else
        for i=0,4 do
            local a=i*math.pi*2/5;local x,z=d.X+math.sin(a)*17-24,d.Z+math.cos(a)*17
            local c=part(m,"StormCrystal",x,14+i%2*2,z,4,16,4,{137,157,234},Enum.Material.Neon,"WedgePart")
            c.CFrame=c.CFrame*CFrame.Angles(0,a,0.2)
        end
    end
end
function A.Build()
    local existing=Workspace:FindFirstChild("QuietCoveArchipelago")
    if existing then return existing end
    local folder=Instance.new("Model");folder.Name="QuietCoveArchipelago";folder.Parent=Workspace
    for _,d in ipairs(Config.Islands)do
        if d.Theme~="home" and d.Theme~="reef" then island(folder,d)end
        dock(folder,d)
    end
    -- Connect home to the new south-facing harbour without altering original parts.
    part(folder,"HarborPath",0,7.25,38,11,0.15,56,{218,201,155},Enum.Material.Sand)
    local sign=part(folder,"HomeHarborSign",11,9,-8,0.6,4,0.6,{127,101,64},Enum.Material.Wood)
    label(sign,"ЛОДОЧНАЯ ВЕРФЬ → ЮГ\nM — карта островов",4.5,300)
    return folder
end
function A.Attach(world)
    local folder=A.Build();world.Docks={};world.Buyers={world.Merchant}
    for _,d in ipairs(Config.Islands)do
        local m=folder:FindFirstChild("Dock_"..d.Id)
        world.Docks[d.Id]={Id=d.Id,Name=d.Name,Captain=m.Captain.Body,
            Position=Vector3.new(d.DockX,10,d.DockZ+5),
            Berth=Vector3.new(d.DockX+30,Config.Ocean.BoatHeight,d.DockZ+15),Land=Vector3.new(d.DockX+2,11,d.DockZ+5)}
        if m:FindFirstChild("Buyer")then table.insert(world.Buyers,m.Buyer.Body)end
        if d.Theme~="home" and d.Theme~="reef" then
            world.Spots[d.Id]={Center=Vector3.new(d.X,8,d.Z-d.Radius-25),Name=d.Name,Radius=23,Level=d.Level}
        else world.Spots[d.Id].Level=d.Level end
    end
    return world
end
return A
]]></ProtectedString>
					<string name="ScriptGuid">{4A73A503-D148-4FDF-AD0E-0D7F27CBD08E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Archipelago</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc00000990</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC025_00004">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Server-owned arcade boats, physical hulls with constrained float height.
-- Input arrives as axes only. Purchasing, spawn location, ownership, and speed
-- are always decided here. One active boat per player; recalling it is free.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage"):WaitForChild("QuietCove")
local Models=require(RS:WaitForChild("EquipmentModels"))
local Rules=require(RS:WaitForChild("BoatRules"))
local BoatService={};BoatService.__index=BoatService
local function rootOf(player)
    local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid")
    local root=c and c:FindFirstChild("HumanoidRootPart")
    if h and h.Health>0 and root then return root,h end
end
function BoatService:NearDock(player,maxDistance)
    local root=rootOf(player);if not root then return nil end
    local nearest,distance=nil,maxDistance or 19
    for _,dock in pairs(self.World.Docks)do
        local delta=(root.Position-dock.Captain.Position).Magnitude
        if delta<distance then distance=delta;nearest=dock end
    end
    return nearest
end
function BoatService:CanTrade(player)
    if self.Busy(player)then return nil,"Сначала закончи рыбалку." end
    local data=self.Profiles.Get(player)
    if not data then return nil,"Профиль ещё загружается." end
    local dock=self:NearDock(player,20)
    if not dock then return nil,"Подойди к капитану на причале." end
    local _,humanoid=rootOf(player)
    if humanoid.SeatPart then return nil,"Сначала сойди на причал." end
    return data,dock
end
function BoatService:Buy(player,id)
    local data,dock=self:CanTrade(player)
    if not data then self:Notice(player,dock);return end
    local ok,reason=Rules.CanBuy(self.Config,data,id)
    if not ok then self:Notice(player,reason);return end
    -- No yields between checking funds and recording ownership.
    if not data.TestMode then data.Coins=data.Coins-self.Config.BoatById[id].Price end
    data.OwnedBoats=data.OwnedBoats or {};data.OwnedBoats[id]=true;data.BoatId=id
    self.Sync(player);self.Send(player,"BoatShop",{Dock=dock.Id})
    self:Notice(player,"Куплено: "..self.Config.BoatById[id].Name..". Нажми «Вызвать».")
end
function BoatService:Notice(player,message)self.Send(player,"Notice",{Text=message})end
function BoatService:Remove(player)
    local b=self.Active[player];if not b then return end
    self.Active[player]=nil
    if b.Connection then b.Connection:Disconnect()end
    if b.Seat and b.Seat.Occupant then b.Seat.Occupant.Sit=false end
    if b.Model then b.Model:Destroy()end
end
function BoatService:_freeBerth(dock,ignorePlayer)
    for i=0,4 do
        local pos=dock.Berth+Vector3.new(i*24,0,0)
        local occupied=false
        for owner,b in pairs(self.Active)do
            if owner~=ignorePlayer and b.Root and b.Root.Parent and (b.Root.Position-pos).Magnitude<23 then occupied=true;break end
        end
        if not occupied then return pos end
    end
    return nil
end
function BoatService:Spawn(player,id)
    local data,dock=self:CanTrade(player)
    if not data then self:Notice(player,dock);return end
    if type(id)~="string" or not self.Config.BoatById[id] or not (data.OwnedBoats or {})[id] then
        self:Notice(player,"Сначала купи эту лодку.");return
    end
    local pos=self:_freeBerth(dock,player)
    if not pos then self:Notice(player,"Причал занят. Подожди освобождения места.");return end
    self:Remove(player)
    local def=self.Config.BoatById[id]
    local model=Models.Boat(def,false);local root=model.PrimaryPart;local seat=model.PilotSeat
    model:SetAttribute("QuietCoveBoat",true);model:SetAttribute("OwnerUserId",player.UserId)
    model:SetAttribute("BoatId",id);seat:SetAttribute("OwnerUserId",player.UserId)
    model:PivotTo(CFrame.new(pos)*CFrame.Angles(0,math.pi,0))
    local at=Instance.new("Attachment");at.Name="DriveAttachment";at.Parent=root
    local float=Instance.new("AlignPosition");float.Name="Waterline";float.Mode=Enum.PositionAlignmentMode.OneAttachment
    float.Attachment0=at;float.Position=Vector3.new(pos.X,self.Config.Ocean.BoatHeight,pos.Z);float.ApplyAtCenterOfMass=true
    float.ForceLimitMode=Enum.ForceLimitMode.PerAxis;float.ForceRelativeTo=Enum.ActuatorRelativeTo.World
    float.MaxAxesForce=Vector3.new(0,1000000,0);float.MaxVelocity=14;float.Responsiveness=12;float.Parent=root
    local velocity=Instance.new("LinearVelocity");velocity.Name="BoatDrive";velocity.Attachment0=at
    velocity.VelocityConstraintMode=Enum.VelocityConstraintMode.Plane;velocity.RelativeTo=Enum.ActuatorRelativeTo.World
    velocity.PrimaryTangentAxis=Vector3.new(1,0,0);velocity.SecondaryTangentAxis=Vector3.new(0,0,1)
    velocity.PlaneVelocity=Vector2.new(0,0);velocity.ForceLimitsEnabled=true
    velocity.ForceLimitMode=Enum.ForceLimitMode.PerAxis;velocity.MaxPlanarAxesForce=Vector2.new(100000,100000);velocity.Parent=root
    local facing=Instance.new("AlignOrientation");facing.Name="BoatHeading";facing.Mode=Enum.OrientationAlignmentMode.OneAttachment
    facing.Attachment0=at;facing.CFrame=CFrame.Angles(0,math.pi,0);facing.MaxTorque=1000000
    facing.MaxAngularVelocity=3;facing.Responsiveness=18;facing.Parent=root
    local b={Model=model,Root=root,Seat=seat,Float=float,Velocity=velocity,Facing=facing,Def=def,
        Speed=0,Yaw=math.pi,Throttle=0,Steer=0,LastInput=0,Dock=dock,Owner=player,LastSafe=pos,SyncAt=0}
    self.Active[player]=b;model.Parent=self.Folder
    pcall(function()root:SetNetworkOwner(nil)end)
    local board=Instance.new("ProximityPrompt");board.Name="PilotPrompt";board.ActionText="Сесть за штурвал"
    board.ObjectText=def.Name;board.KeyboardKeyCode=Enum.KeyCode.E;board.HoldDuration=0.2
    board.MaxActivationDistance=12;board.RequiresLineOfSight=false;board.Parent=seat
    board.Triggered:Connect(function(p)
        local r,h=rootOf(p)
        if p==player and r and not self.Busy(p) and not seat.Disabled and (r.Position-seat.Position).Magnitude<15 then seat:Sit(h)end
    end)
    b.Connection=seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        local h=seat.Occupant
        local previous=b.Rider;b.Rider=h
        if previous and previous~=h and previous.Parent then
            local oldRoot=previous.Parent:FindFirstChild("HumanoidRootPart")
            local previousPlayer=Players:GetPlayerFromCharacter(previous.Parent)
            task.delay(0.12,function()
                if oldRoot and oldRoot.Parent and not previous.SeatPart then
                    pcall(function()
                        if previousPlayer then oldRoot:SetNetworkOwner(previousPlayer)else oldRoot:SetNetworkOwnershipAuto()end
                    end)
                end
            end)
        end
        if h and Players:GetPlayerFromCharacter(h.Parent)~=player then h.Sit=false;h.Jump=true end
        b.Throttle=0;b.Steer=0;b.LastInput=0
        pcall(function()root:SetNetworkOwner(nil)end)
    end)
    data.BoatId=id;self.Sync(player)
    self.Send(player,"BoatLaunched",{Id=id,Dock=dock.Id})
    self:Notice(player,"W/S — ход, A/D — поворот. M — карта. E рядом с причалом — сойти.")
    -- Server positions only its owner, after the assembly exists; no client target CFrame.
    local character=player.Character
    task.delay(0.15,function()
        local r,h=rootOf(player)
        if self.Active[player]~=b or player.Character~=character or not r then return end
        if (r.Position-dock.Captain.Position).Magnitude>35 or self.Busy(player)then return end
        r.CFrame=seat.CFrame*CFrame.new(0,2.5,0);seat:Sit(h)
    end)
end
function BoatService:Input(player,value)
    local b=self.Active[player];if not b then return end
    local _,h=rootOf(player)
    if not h or b.Seat.Occupant~=h then return end
    local throttle,steer=Rules.Input(value);if throttle==nil then return end
    b.Throttle=throttle;b.Steer=steer;b.LastInput=os.clock()
end
function BoatService:Dock(player)
    local b=self.Active[player];local r,h=rootOf(player)
    if not b or not r or b.Seat.Occupant~=h then return end
    local dock,best=nil,58
    for _,d in pairs(self.World.Docks)do
        local dist=(b.Root.Position-d.Berth).Magnitude
        if dist<best then dock=d;best=dist end
    end
    if not dock then self:Notice(player,"Подплыви к деревянному причалу острова.");return end
    b.Speed=0;b.Throttle=0;b.Steer=0;b.Velocity.PlaneVelocity=Vector2.new(0,0)
    b.Root.AssemblyLinearVelocity=Vector3.new(0,0,0);b.Root.AssemblyAngularVelocity=Vector3.new(0,0,0)
    b.Seat.Disabled=true;h.Sit=false
    local joint=b.Seat:FindFirstChild("SeatWeld");if joint then joint:Destroy()end
    local character=player.Character
    task.delay(0.05,function()
        if player.Character==character and character.Parent and r.Parent and h.Health>0 then
            r.CFrame=CFrame.new(dock.Land);r.AssemblyLinearVelocity=Vector3.new(0,0,0)
            pcall(function()r:SetNetworkOwner(player)end)
        end
    end)
    task.delay(1,function()if self.Active[player]==b and b.Seat.Parent then b.Seat.Disabled=false end end)
    self:Notice(player,"Причал: "..dock.Name..". Рыбалка — на противоположном, северном пирсе.")
end
function BoatService:_step(dt)
    local now=os.clock()
    for player,b in pairs(self.Active)do
        if not b.Root.Parent or player.Parent~=Players then self:Remove(player)
        else
            local _,h=rootOf(player)
            local driving=h and b.Seat.Occupant==h
            local throttle,steer=0,0
            if driving and now-b.LastInput<0.55 then throttle=b.Throttle;steer=b.Steer end
            b.Speed,b.Yaw=Rules.Step(b.Speed,b.Yaw,throttle,steer,dt,b.Def)
            local pos=b.Root.Position
            local bound=self.Config.Ocean.HalfExtent
            if math.abs(pos.X)>bound or math.abs(pos.Z)>bound or pos.Y<-15 or pos.Y>30 then
                b.Model:PivotTo(CFrame.new(b.LastSafe)*CFrame.Angles(0,b.Yaw,0))
                b.Root.AssemblyLinearVelocity=Vector3.new(0,0,0);b.Speed=0
                if driving then self:Notice(player,"Граница архипелага. Поверни к островам.")end
            else b.LastSafe=pos end
            local mass=b.Root.AssemblyMass
            if mass>0 and mass<1000000 then
                b.Float.MaxAxesForce=Vector3.new(0,mass*workspace.Gravity*5,0)
                b.Velocity.MaxPlanarAxesForce=Vector2.new(mass*b.Def.Acceleration*2,mass*b.Def.Acceleration*2)
                b.Facing.MaxTorque=mass*18000
            end
            -- Gentle tide remains cosmetic and does not throw the passenger.
            b.Float.Position=Vector3.new(pos.X,self.Config.Ocean.BoatHeight+math.sin(now*1.4)*0.06,pos.Z)
            b.Facing.CFrame=CFrame.Angles(0,b.Yaw,0)
            b.Velocity.PlaneVelocity=Vector2.new(-math.sin(b.Yaw)*b.Speed,-math.cos(b.Yaw)*b.Speed)
            if now>=b.SyncAt then
                b.SyncAt=now+0.3
                b.Model:SetAttribute("Speed",math.floor(math.abs(b.Speed)))
            end
        end
    end
end
function BoatService.new(config,world,profiles,send,sync,busy)
    local folder=Instance.new("Folder");folder.Name="QuietCoveBoats";folder.Parent=workspace
    local self=setmetatable({Config=config,World=world,Profiles=profiles,Send=send,Sync=sync,Busy=busy,Folder=folder,Active={},OpenedAt={}},BoatService)
    for _,dock in pairs(world.Docks)do
        dock.Captain.CaptainPrompt.Triggered:Connect(function(player)
            local now=os.clock()
            if now-(self.OpenedAt[player] or -10)<0.5 then return end
            self.OpenedAt[player]=now
            local data,reason=self:CanTrade(player)
            if not data then self:Notice(player,reason);return end
            self.Send(player,"BoatShop",{Dock=dock.Id})
        end)
    end
    self.Connection=RunService.Heartbeat:Connect(function(dt)self:_step(dt)end)
    Players.PlayerRemoving:Connect(function(p)self:Remove(p);self.OpenedAt[p]=nil end)
    return self
end
return BoatService
]]></ProtectedString>
					<string name="ScriptGuid">{12CC1B44-2DCF-45B5-8463-10E2B860DD94}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">BoatService</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc00000991</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXQC026_00002">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- SERVER ONLY. Not in ReplicatedStorage. No remote can edit this allowlist.
-- ASUL7664 is a Roblox username, never a DisplayName. Studio Player1 is NOT allowed.
local Players = game:GetService("Players")
local Access = {}
Access.Enabled = true
Access.Username = "ASUL7664"
Access.PinnedUserId = 0 -- Optional: set a verified numeric UserId to survive username changes.
Access.VirtualCoins = 1000000000
Access.VirtualXP = 99999900 -- finite; level 1,000,000 with 100 XP/level
local resolvedId = nil
function Access.IsTester(player)
    if not Access.Enabled or not player or type(player.UserId) ~= "number" or player.UserId <= 0 then return false end
    if Access.PinnedUserId > 0 then return player.UserId == Access.PinnedUserId end
    if resolvedId then return player.UserId == resolvedId end
    -- Name comes from the server's authenticated Player, not from the client.
    return type(player.Name) == "string" and string.lower(player.Name) == string.lower(Access.Username)
end
function Access.Resolve()
    if not Access.Enabled or Access.PinnedUserId > 0 then return end
    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(Access.Username) end)
    if ok and type(id) == "number" and id > 0 then resolvedId = id end
    -- Service unavailable: exact server username remains a valid fallback.
end
local function copy(value)
    if type(value) ~= "table" then return value end
    local out = {}; for k, v in pairs(value) do out[k] = copy(v) end; return out
end
function Access.Sandbox(player, saved)
    if not Access.IsTester(player) then return nil end
    local data = copy(saved)
    data.TestMode = true
    data.Coins = Access.VirtualCoins
    data.XP = Access.VirtualXP
    return data
end
function Access.Refresh(data)
    data.TestMode = true
    data.Coins = Access.VirtualCoins
    data.XP = Access.VirtualXP
    return data
end
return Access
]]></ProtectedString>
