			</Item>
			<Item class="ModuleScript" referent="RBXQC025_00005">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Editable local 3D previews; no external asset IDs required.
local Models=require(game:GetService("ReplicatedStorage"):WaitForChild("QuietCove"):WaitForChild("EquipmentModels"))
local Preview={}
function Preview.Create(parent,kind,definition,size,position)
    local v=Instance.new("ViewportFrame");v.Name="EquipmentPreview";v.Size=size;v.Position=position
    v.BackgroundTransparency=1;v.Ambient=Color3.fromRGB(190,195,204)
    v.LightColor=Color3.fromRGB(255,243,214);v.LightDirection=Vector3.new(-1,-1,-1);v.Parent=parent
    local world=Instance.new("WorldModel");world.Parent=v
    local wrap=Instance.new("Model");wrap.Parent=world
    local item=kind=="rod" and Models.Rod(definition.Id,true) or Models.Boat(definition,true)
    item.Parent=wrap
    local cf,bounds=wrap:GetBoundingBox()
    local extent=math.max(bounds.X,bounds.Y,bounds.Z)
    local camera=Instance.new("Camera");camera.FieldOfView=30
    local distance=extent*1.85
    camera.CFrame=CFrame.lookAt(cf.Position+Vector3.new(distance*0.65,distance*0.3,distance),cf.Position)
    camera.Parent=v;v.CurrentCamera=camera
    return v
end
return Preview
]]></ProtectedString>
					<string name="ScriptGuid">{7CCACF64-EC1A-4A4D-88FD-B86D335BBFD5}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ModelPreview</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c0881adfdaa96610ad1e7dc000009a7</UniqueId>
