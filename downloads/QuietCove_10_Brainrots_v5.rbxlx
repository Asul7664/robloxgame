				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RS=game:GetService('ReplicatedStorage')
local Models=require(RS:WaitForChild('QuietCove'):WaitForChild('CreatureModels'))
local View={}
function View.Mount(parent,id,animated,known)
    local v=Instance.new('ViewportFrame');v.Name='Creature3D';v.Size=UDim2.fromScale(1,1)
    v.BackgroundTransparency=1;v.Ambient=Color3.fromRGB(172,182,206)
    v.LightColor=Color3.fromRGB(255,244,224);v.LightDirection=Vector3.new(-1,-1,-2);v.ZIndex=3;v.Parent=parent
    local w=Instance.new('WorldModel');w.Parent=v
    local model=Models.Create(id,w)
    if not model then v:Destroy();return nil end
    local cf,bounds=model:GetBoundingBox();local size=math.max(bounds.X,bounds.Y,bounds.Z)
    local camera=Instance.new('Camera');camera.FieldOfView=30
    camera.CFrame=CFrame.lookAt(cf.Position+Vector3.new(size*.9,size*.37,-size*2),cf.Position)
    camera.Parent=v;v.CurrentCamera=camera
    if known==false then
        for _,p in ipairs(model:GetDescendants())do if p:IsA('BasePart')and p.Transparency<1 then
            p.Color=Color3.fromRGB(32,44,62);p.Material=Enum.Material.SmoothPlastic
        end end
    end
    local handle={Ready=true,Mode='model3d',Root=v,Model=model,Visible=true}
    local binding=Models.Bind(model)
    function handle:SetVisible(yes)self.Visible=yes;v.Visible=yes end
    if animated then
        handle.Connection=game:GetService('RunService').RenderStepped:Connect(function()
            if handle.Visible and v.Parent then Models.Animate(model,binding,CFrame.new(),os.clock(),0)end
        end)
    end
    function handle:Destroy()if self.Connection then self.Connection:Disconnect()end;v:Destroy()end
    v.Destroying:Connect(function()if handle.Connection then handle.Connection:Disconnect();handle.Connection=nil end end)
    return handle
end
return View
]]></ProtectedString>
